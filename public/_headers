# Cloudflare Pages headers.
#
# Pages MERGES the headers of every matching rule; a more specific rule does not
# override a broader one. So Cache-Control is never set on /*: it would be joined
# onto every rule below. HTML gets no Cache-Control and uses the Pages default.
# The CSP is a <meta> tag generated by Astro; frame-ancestors cannot be set there,
# so X-Frame-Options stays here.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Content-hashed build output (scripts, styles, images, fonts).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed file names: a week, not immutable.
/video/*
  Cache-Control: public, max-age=604800

# SEO and AI files: short cache so updates ship quickly.
/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
