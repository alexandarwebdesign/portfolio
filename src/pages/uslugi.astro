---
import Base from '../layouts/Base.astro';
import Uslugi from '../views/Uslugi.astro';
import { uslugiCopy } from '../data/uslugi';
import { ui } from '../i18n/ui';
const uslugi = uslugiCopy.bg;
import { uslugiSchema } from '../data/schema';
---

<Base
  title={uslugi.meta.title}
  description={uslugi.meta.description}
  route="uslugi"
  schema={uslugiSchema('bg', '/uslugi')}
  crumb={ui.bg.nav.services}
>
  <Uslugi lang="bg" />
</Base>
