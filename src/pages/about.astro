---
import Base from '../layouts/Base.astro';
import About from '../views/About.astro';
import { ui } from '../i18n/ui';
import { aboutSchema } from '../data/schema';
const meta = ui.bg.meta.about;
---

<Base
  bodyClass="about-page"
  title={meta.title}
  description={meta.description}
  route="about"
  schema={aboutSchema('bg', '/about')}
  crumb={ui.bg.nav.about}
>
  <About lang="bg" />
</Base>
