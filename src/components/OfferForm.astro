---
// The original /uslugi request form (Web3Forms): name, phone, email, kind of
// business, city, whether there is a site, and a short message.
import Button from './Button.astro';
import { uslugiCopy } from '../data/uslugi';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = uslugiCopy[lang].form;
---

<form
  class="contact-form reveal"
  id="offer-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  aria-label={f.aria}
  data-copy={JSON.stringify({
    errors: f.errors,
    fix: f.fix,
    sending: f.sending,
    sent: f.sent,
    failed: f.failed,
  })}
  novalidate
>
  <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value={f.subject} />
  <input type="hidden" name="from_name" value="Portfolio /uslugi" />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display: none;"
    tabindex="-1"
    autocomplete="off"
  />
  <div class="form-group">
    <label for="offer-name" class="form-label">{f.name}</label>
    <input
      type="text"
      id="offer-name"
      name="name"
      class="form-input"
      placeholder={f.namePh}
      autocomplete="name"
      required
      aria-required="true"
      aria-describedby="offer-name-error"
    />
    <span id="offer-name-error" class="form-error" role="alert" hidden></span>
  </div>
  <div class="offer-form-row">
    <div class="form-group">
      <label for="offer-phone" class="form-label">{f.phone}</label>
      <input
        type="tel"
        id="offer-phone"
        name="phone"
        class="form-input"
        placeholder="+359 …"
        autocomplete="tel"
        required
        aria-required="true"
        aria-describedby="offer-phone-error"
      />
      <span id="offer-phone-error" class="form-error" role="alert" hidden></span>
    </div>
    <div class="form-group">
      <label for="offer-email" class="form-label">{f.email}</label>
      <input
        type="email"
        id="offer-email"
        name="email"
        class="form-input"
        placeholder={f.emailPh}
        autocomplete="email"
        required
        aria-required="true"
        aria-describedby="offer-email-error"
      />
      <span id="offer-email-error" class="form-error" role="alert" hidden></span>
    </div>
  </div>
  <div class="offer-form-row">
    <div class="form-group">
      <label for="offer-business" class="form-label">{f.business}</label>
      <input
        type="text"
        id="offer-business"
        name="business"
        class="form-input"
        placeholder={f.businessPh}
        autocomplete="off"
        required
        aria-required="true"
        aria-describedby="offer-business-error"
      />
      <span id="offer-business-error" class="form-error" role="alert" hidden></span>
    </div>
    <div class="form-group">
      <label for="offer-city" class="form-label">{f.city}</label>
      <input
        type="text"
        id="offer-city"
        name="city"
        class="form-input"
        placeholder={f.cityPh}
        autocomplete="address-level2"
        required
        aria-required="true"
        aria-describedby="offer-city-error"
      />
      <span id="offer-city-error" class="form-error" role="alert" hidden></span>
    </div>
  </div>
  <div class="form-group">
    <label for="offer-hassite" class="form-label">{f.hasSite}</label>
    <div class="select-wrapper">
      <select
        id="offer-hassite"
        name="hassite"
        class="form-input form-select"
        required
        aria-required="true"
        aria-describedby="offer-hassite-error"
      >
        <option value="" disabled selected>{f.choose}</option>
        <option value="да">{f.yes}</option>
        <option value="не">{f.no}</option>
        <option value="остарял">{f.outdated}</option>
      </select>
    </div>
    <span id="offer-hassite-error" class="form-error" role="alert" hidden></span>
  </div>
  <div class="form-group">
    <label for="offer-message" class="form-label">{f.message}</label>
    <textarea
      id="offer-message"
      name="message"
      class="form-input form-textarea"
      placeholder={f.messagePh}
      rows="4"
      autocomplete="off"></textarea>
  </div>
  <Button type="submit" class="form-submit">{f.submit}</Button>
  <p class="form-helper">{f.helper}</p>
  <p id="offer-status" class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
</form>

<script>
  // The original offer.js request form handling.
  const form = document.getElementById('offer-form') as HTMLFormElement | null;
  const status = document.getElementById('offer-status');
  const copy = JSON.parse(form?.dataset.copy ?? '{}') as {
    errors: Record<string, string>;
    fix: string;
    sending: string;
    sent: string;
    failed: string;
  };
  const required = copy.errors ?? {};

  const setStatus = (text: string, state?: string) => {
    if (!status) return;
    status.textContent = text;
    if (state) status.dataset.state = state;
    else delete status.dataset.state;
  };

  // Validate a field when the visitor leaves it; clear the message once fixed.
  const check = (id: string) => {
    const field = document.getElementById(id) as HTMLInputElement;
    const error = document.getElementById(`${id}-error`)!;
    const value = field.value.trim();
    let ok = value.length > 0;
    if (id === 'offer-email') ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
    if (id === 'offer-phone') ok = value.replace(/\D/g, '').length >= 7;
    if (ok) field.removeAttribute('aria-invalid');
    else field.setAttribute('aria-invalid', 'true');
    error.textContent = ok ? '' : required[id];
    error.hidden = ok;
  };
  for (const id of Object.keys(required)) {
    const field = document.getElementById(id);
    field?.addEventListener(field.tagName === 'SELECT' ? 'change' : 'blur', () => check(id));
    field?.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') check(id);
    });
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    setStatus('');
    const bad: string[] = [];
    for (const id of Object.keys(required)) {
      const field = document.getElementById(id) as HTMLInputElement;
      const error = document.getElementById(`${id}-error`)!;
      field.removeAttribute('aria-invalid');
      error.hidden = true;
      error.textContent = '';
      const value = field.value.trim();
      let ok = value.length > 0;
      if (id === 'offer-email') ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      if (id === 'offer-phone') ok = value.replace(/\D/g, '').length >= 7;
      if (!ok) bad.push(id);
    }
    if (bad.length) {
      for (const id of bad) {
        document.getElementById(id)!.setAttribute('aria-invalid', 'true');
        const error = document.getElementById(`${id}-error`)!;
        error.textContent = required[id];
        error.hidden = false;
      }
      document.getElementById(bad[0])!.focus();
      setStatus(copy.fix, 'error');
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    setStatus(copy.sending);
    fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form) })
      .then(async (response) => {
        const json = await response.json();
        if (response.status !== 200) throw new Error(json.message || 'error');
        form.reset();
        setStatus(copy.sent, 'success');
      })
      .catch(() => setStatus(`${copy.failed} alexandar.webdesign@gmail.com.`, 'error'))
      .finally(() => {
        button.disabled = false;
      });
  });
</script>
