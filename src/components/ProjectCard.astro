---
// Project card: the image leads, the words follow underneath. No frame and no
// shadow; the image sits on a slightly darker plate, and on hover it grows a
// little inside its frame while the arrow fills in. Work without a case study
// shows its status on the image instead of linking.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  category: string;
  image: ImageMetadata;
  /** Case study URL; without one the card shows its status instead of linking. */
  href?: string;
  status?: string;
  /** Marks self-initiated work, e.g. "Concept". */
  tag?: string;
}

const { name, category, image, href, status, tag } = Astro.props;
const Tagname = href ? 'a' : 'div';
---

<li class:list={['project-card', { upcoming: !href }]}>
  <Tagname class="link" href={href}>
    <span class="media reveal-media">
      <Picture
        src={image}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(width >= 104rem) 52rem, (width >= 56.25rem) 46vw, 92vw"
        alt=""
        loading="lazy"
      />
      {status && <span class="status">{status}</span>}
    </span>
    <span class="meta">
      <span class="text">
        <h3 class="name">{name}</h3>
        <span class="category">
          {category}
          {tag && <span class="tag">{tag}</span>}
        </span>
      </span>
      {
        href && (
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="16" height="16">
              <path
                d="M4 12 12 4M5.5 4H12v6.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>
          </span>
        )
      }
    </span>
  </Tagname>
</li>

<style>
  .link {
    display: grid;
    gap: var(--space-5);
    color: inherit;
    text-decoration: none;
  }

  .link:focus-visible {
    outline-offset: 6px;
  }

  .media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background-color: var(--bg-sunken);
  }

  .media :global(img) {
    width: 100%;
    aspect-ratio: 400 / 284;
    object-fit: cover;
    transition:
      scale 900ms var(--ease-out),
      filter 600ms var(--ease-out);
  }

  .meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .text {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .name {
    font-size: var(--text-heading);
    line-height: 1;
  }

  .category {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-small);
  }

  /* Self-initiated work is never read as client work. */
  .tag {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--fg);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
  }

  .arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .arrow svg {
    transition: translate var(--dur) var(--ease-out);
  }

  /* Not linked yet: muted image, status label on it. */
  .upcoming .media :global(img) {
    filter: grayscale(1) contrast(0.9);
    opacity: 0.7;
  }

  .status {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    background-color: var(--ink);
    color: var(--mist);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  a.link:hover .media :global(img),
  a.link:focus-visible .media :global(img) {
    scale: 1.04;
  }

  a.link:hover .arrow,
  a.link:focus-visible .arrow {
    border-color: var(--fg);
    background-color: var(--fg);
    color: var(--bg);
  }

  a.link:hover .arrow svg,
  a.link:focus-visible .arrow svg {
    translate: 2px -2px;
  }
</style>
