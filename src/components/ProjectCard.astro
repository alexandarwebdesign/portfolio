---
// The original project card: full-bleed image, a glass "Name · Category"
// pill, a corner tag for self-initiated work, and an overlay with the status
// for work that has no case study yet.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  category: string;
  image: ImageMetadata;
  href?: string;
  status?: string;
  tag?: string;
}

const { name, category, image, href, status, tag } = Astro.props;
const Link = href ? 'a' : 'div';
---

<article class:list={['project-card', 'reveal', { 'project-card--upcoming': !href }]}>
  <Link href={href} class:list={['project-card-link', { 'project-card-link--disabled': !href }]}>
    <div class="project-image-wrapper">
      <Picture
        src={image}
        formats={['avif', 'webp']}
        widths={[500, 800, 1080, 1600].filter((w) => w <= image.width)}
        sizes="(max-width: 900px) calc(100vw - 48px), (max-width: 1648px) calc((100vw - 76px) / 2), 762px"
        alt=""
        loading="lazy"
      />
      {tag && <span class="project-concept-tag">{tag}</span>}
      {
        status && (
          <div class="project-upcoming-overlay">
            <span class="project-upcoming-label">{status}</span>
          </div>
        )
      }
    </div>
    <div class="project-pill">
      <h3 class="project-pill-name">{name}</h3>
      <span class="project-pill-sep" aria-hidden="true">·</span>
      <span class="project-pill-category">{category}</span>
    </div>
  </Link>
</article>
