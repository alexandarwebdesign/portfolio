---
import Button from './Button.astro';
import { ui, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].brief;
const choices = [
  { name: 'type', ...t.type },
  { name: 'timeline', ...t.timeline },
  { name: 'budget', ...t.budget },
] as const;
const total = choices.length + 1;
---

<!--
  Without JavaScript this is one plain form with native validation.
  The script turns it into four short steps with a summary before sending.
-->
<form
  class="brief"
  action="https://api.web3forms.com/submit"
  method="POST"
  aria-label={t.label}
  data-required={t.required}
  data-email-error={t.details.emailError}
>
  <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value={t.subject} />
  <input type="hidden" name="language" value={lang} />
  <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" />

  <div class="progress" hidden>
    <p aria-live="polite">
      {t.step}
      <span data-current>1</span>
      {t.of}
      {total}
    </p>
    <span class="track"><span class="fill"></span></span>
  </div>

  {
    choices.map((group, index) => (
      <fieldset
        class="step"
        data-step={index}
        tabindex="-1"
        aria-describedby={`${group.name}-error`}
      >
        <legend>{group.legend}</legend>
        <div class="chips">
          {group.options.map((option) => (
            <label class="chip">
              <input type="radio" name={group.name} value={option} required />
              <span>{option}</span>
            </label>
          ))}
        </div>
        <p class="error" id={`${group.name}-error`} role="alert" />
      </fieldset>
    ))
  }

  <fieldset class="step" data-step={choices.length} tabindex="-1">
    <legend>{t.details.legend}</legend>
    <div class="field">
      <label for="brief-email">{t.details.email}</label>
      <input
        id="brief-email"
        type="email"
        name="email"
        autocomplete="email"
        required
        aria-describedby="email-error"
      />
      <p class="error" id="email-error" role="alert"></p>
    </div>
    <div class="field">
      <label for="brief-message">{t.details.message}</label>
      <textarea id="brief-message" name="message" rows="3" aria-describedby="message-hint"
      ></textarea>
      <p class="hint" id="message-hint">{t.details.hint}</p>
    </div>

    <div class="summary" hidden>
      <h3>{t.summary}</h3>
      <dl>
        {
          choices.map((group, index) => (
            <div>
              <dt>{group.legend}</dt>
              <dd>
                <span data-answer={group.name} />
                <button type="button" class="edit" data-goto={index}>
                  {t.edit}
                  <span class="visually-hidden">: {group.legend}</span>
                </button>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </fieldset>

  <div class="actions">
    <button type="button" class="back" data-back hidden>{t.back}</button>
    <Button type="button" data-next hidden arrow>{t.next}</Button>
    <Button type="submit" data-submit arrow>{t.send}</Button>
  </div>
  <p class="privacy">{t.privacy}</p>
  <p class="status" role="status" data-sending={t.sending} data-success={t.success}></p>
  <p class="status-error" hidden>
    {t.error}
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.brief')) {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('.step')];
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const progress = form.querySelector<HTMLElement>('.progress')!;
    const current = form.querySelector<HTMLElement>('[data-current]')!;
    const summary = form.querySelector<HTMLElement>('.summary')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const statusError = form.querySelector<HTMLElement>('.status-error')!;
    const email = form.querySelector<HTMLInputElement>('input[type=email]')!;
    let index = 0;

    form.noValidate = true;
    progress.hidden = false;
    summary.hidden = false;

    const show = (to: number, focus = true) => {
      index = to;
      steps.forEach((step, i) => (step.hidden = i !== to));
      const last = to === steps.length - 1;
      back.hidden = to === 0;
      next.hidden = last;
      submit.hidden = !last;
      current.textContent = String(to + 1);
      progress.style.setProperty('--progress', String((to + 1) / steps.length));
      if (last) {
        for (const answer of form.querySelectorAll<HTMLElement>('[data-answer]')) {
          answer.textContent = String(new FormData(form).get(answer.dataset.answer!) ?? '');
        }
      }
      if (focus) steps[to].focus();
    };

    const setError = (field: HTMLElement, message: string) => {
      const error = form.querySelector<HTMLElement>(`#${field.getAttribute('aria-describedby')}`)!;
      error.textContent = message;
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
    };

    // A choice step is valid once any radio in it is checked.
    const validChoice = (step: HTMLFieldSetElement) => {
      const ok = step.querySelector('input:checked') !== null;
      setError(step, ok ? '' : form.dataset.required!);
      if (!ok) step.querySelector('input')!.focus();
      return ok;
    };

    const validEmail = () => {
      const ok = email.checkValidity();
      setError(email, ok ? '' : form.dataset.emailError!);
      if (!ok) email.focus();
      return ok;
    };

    next.addEventListener('click', () => {
      if (validChoice(steps[index])) show(index + 1);
    });
    back.addEventListener('click', () => show(index - 1));
    form.addEventListener('change', (event) => {
      const step = (event.target as Element).closest<HTMLFieldSetElement>('.step');
      if (step && step.hasAttribute('aria-invalid')) setError(step, '');
    });
    email.addEventListener('blur', () => email.value && validEmail());
    for (const edit of form.querySelectorAll<HTMLButtonElement>('[data-goto]')) {
      edit.addEventListener('click', () => show(Number(edit.dataset.goto)));
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const invalid = steps.slice(0, -1).findIndex((step) => !step.querySelector('input:checked'));
      if (invalid !== -1) {
        show(invalid, false);
        validChoice(steps[invalid]);
        return;
      }
      if (!validEmail()) return;

      submit.disabled = true;
      statusError.hidden = true;
      status.textContent = status.dataset.sending!;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message);
        form.replaceChildren(status);
        status.textContent = status.dataset.success!;
        status.tabIndex = -1;
        status.focus();
      } catch {
        status.textContent = '';
        statusError.hidden = false;
        submit.disabled = false;
      }
    });

    show(0, false);
  }
</script>

<style>
  .brief {
    display: grid;
    gap: var(--space-5);
  }

  .trap {
    display: none;
  }

  .progress {
    display: grid;
    gap: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-small);
  }

  .track {
    height: 2px;
    background-color: var(--line);
  }

  .fill {
    display: block;
    height: 100%;
    background-color: var(--accent);
    transform-origin: left;
    scale: var(--progress, 0.25) 1;
    transition: scale var(--dur) var(--ease-out);
  }

  .step {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    padding: 0;
    border: 0;
  }

  .step:focus {
    outline: none;
  }

  legend {
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-title);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-heading);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--fg);
  }

  .chip:has(:checked) {
    border-color: var(--accent);
    background-color: var(--accent);
    color: var(--on-accent);
  }

  .chip:has(:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: var(--target);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background-color: var(--bg-raised);
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--focus);
  }

  [aria-invalid] input[type='radio'] + span,
  .field input[aria-invalid] {
    border-color: var(--error);
  }

  .hint,
  .privacy {
    color: var(--fg-muted);
    font-size: var(--text-small);
  }

  .error,
  .status-error {
    color: var(--error);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .error:empty {
    display: none;
  }

  .summary {
    padding: var(--space-5);
    border: var(--hairline);
    border-radius: var(--radius);
  }

  .summary h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-title);
  }

  .summary dl > div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: var(--hairline);
  }

  dt {
    color: var(--fg-muted);
    font-size: var(--text-small);
  }

  dd {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    font-weight: 600;
  }

  .edit,
  .back {
    min-height: var(--target);
    padding-inline: var(--space-3);
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .actions :global([data-next]),
  .actions :global([data-submit]) {
    margin-inline-start: auto;
  }

  [hidden] {
    display: none !important;
  }

  .status:empty {
    display: none;
  }

  .status {
    font-size: var(--text-lead);
  }

  .status:focus {
    outline: none;
  }
</style>
