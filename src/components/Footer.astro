---
// The footer: revealed from under the page (sticky), one screen tall. The call to action in the
// middle with the top half of a large ring of ticks arching over the title, the links, the profiles, the location and the copyright below.
import Button from './Button.astro';
import TickRing from './TickRing.astro';
import bgFlag from '../assets/icons/flags/bg.svg';
import enFlag from '../assets/icons/flags/us.svg';
import { ui, type Lang } from '../i18n/ui';
import { pathFor, type RouteId } from '../i18n/routes';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  route: RouteId;
}

const { lang, route } = Astro.props;
const t = ui[lang];
const home = pathFor('home', lang)!;
const contact =
  route === 'home' || route === 'uslugi' ? '#contact' : `${home === '/' ? '' : home}/#contact`;
const year = new Date().getFullYear();
// The other language: the same page when it exists, otherwise its home page.
const otherLang: Lang = lang === 'bg' ? 'en' : 'bg';
const otherRoute = route === 'notFound' ? 'home' : route;
const otherHref = pathFor(otherRoute, otherLang) ?? pathFor('home', otherLang)!;
const otherName = otherLang === 'bg' ? 'Български' : 'English';
const privacyHref = pathFor('privacy', lang)!;
// The same links as the navigation.
const hash = (id: string) => (route === 'home' ? `#${id}` : `${home === '/' ? '' : home}/#${id}`);
const links = [
  { href: hash('work'), label: t.nav.work },
  { href: pathFor('about', lang)!, label: t.nav.about },
  { href: pathFor('uslugi', lang)!, label: t.nav.services },
  { href: contact, label: t.nav.contact },
];
const social = [
  {
    url: 'https://x.com/pavvlov_16',
    label: t.site.followX,
    d: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    url: 'https://dribbble.com/alexandar-webdesign',
    label: t.site.followDribbble,
    d: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm6.605 4.61a8.502 8.502 0 011.93 5.314c-.281-.054-3.101-.629-5.943-.271-.065-.141-.12-.293-.184-.445a25.416 25.416 0 00-.564-1.236c3.145-1.28 4.577-3.124 4.761-3.362zM12 3.475c2.17 0 4.154.813 5.662 2.148-.152.216-1.443 1.941-4.48 3.08-1.399-2.57-2.95-4.675-3.189-5A8.687 8.687 0 0112 3.475zm-3.633.803a53.896 53.896 0 013.167 4.935c-3.992 1.063-7.517 1.04-7.896 1.04a8.581 8.581 0 014.729-5.975zM3.453 12.01v-.26c.37.01 4.512.065 8.775-1.215.25.477.477.965.694 1.453-.109.033-.228.065-.336.098-4.404 1.42-6.747 5.303-6.942 5.629a8.522 8.522 0 01-2.19-5.705zM12 20.547a8.482 8.482 0 01-5.239-1.8c.152-.315 1.888-3.656 6.703-5.337.022-.01.033-.01.054-.022a35.318 35.318 0 011.823 6.475 8.4 8.4 0 01-3.341.684zm4.761-1.465c-.086-.52-.542-3.015-1.659-6.084 2.679-.423 5.022.271 5.314.369a8.468 8.468 0 01-3.655 5.715z',
  },
  {
    url: 'https://www.linkedin.com/in/alexander-pavlov-370261342/',
    label: t.site.followLinkedIn,
    d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
];
---

<div class="footer-reveal">
  <footer class="footer" data-lenis-prevent>
    <div class="footer-inner">
      <div class="footer-cta">
        <TickRing corner="center" />
        <div class="footer-cta__body">
          <p class="footer-cta-title">{t.footer.title}</p>
          <Button href={contact} data-focus-target="#name">{t.site.letsTalk}</Button>
        </div>
      </div>
      <div class="footer-base">
        <div class="footer-row">
          <nav class="footer-nav" aria-label={t.nav.label}>
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
          <div class="footer-social">
            {
              social.map((s) => (
                <a
                  href={s.url}
                  class="footer-social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="social-icon"
                    aria-hidden="true"
                  >
                    <path d={s.d} />
                  </svg>
                </a>
              ))
            }
          </div>
        </div>
        <div class="footer-row footer-row--meta">
          <div class="footer-meta">
            <a href={`mailto:${site.email}`} class="footer-email">{site.email}</a>
            <p class="footer-location">
              <svg
                class="footer-location__pin"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{t.footer.location}</span>
            </p>
          </div>
          <div class="footer-legal">
            <p class="footer-copyright">
              &copy; {year}
              {site.name[lang]}<br />{t.footer.role}
            </p>
            <nav class="footer-small-links" aria-label={t.footer.privacy}>
              <a href={privacyHref} aria-current={route === 'privacy' ? 'page' : undefined}>
                {t.footer.privacy}
              </a>
              <a
                href={otherHref}
                class="footer-lang"
                lang={otherLang}
                hreflang={otherLang}
                title={otherName}
                aria-label={otherName}
              >
                <span class="lang-option" data-active={lang === 'bg' ? '' : undefined}>
                  <img src={bgFlag.src} width="22" height="22" alt="" />
                  <span aria-hidden="true">БГ</span>
                </span>
                <span class="lang-option" data-active={lang === 'en' ? '' : undefined}>
                  <img src={enFlag.src} width="22" height="22" alt="" />
                  <span aria-hidden="true">EN</span>
                </span>
              </a>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </footer>
</div>
