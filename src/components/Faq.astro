---
// The original FAQ: hairline rows, one open at a time (site script), "+" that
// turns into "×".
interface Props {
  items: { q: string; a: string }[];
  /** Prefix for the item ids, so a link can open one (#faq-1). */
  idPrefix?: string;
}

const { items, idPrefix = 'faq' } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item, i) => (
      <div id={`${idPrefix}-${i + 1}`} class="faq-item reveal">
        <button type="button" class="faq-question" aria-expanded="false">
          <span>{item.q}</span>
          <span class="faq-icon" aria-hidden="true" />
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p>{item.a}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>
