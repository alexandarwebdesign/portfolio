---
// The original FAQ: hairline rows, one open at a time (site script), "+" that
// turns into "×".
interface Props {
  items: { q: string; a: string }[];
  /** Prefix for the item ids, so a link can open one (#faq-1). */
  idPrefix?: string;
  /** Open the first question on load. */
  openFirst?: boolean;
}

const { items, idPrefix = 'faq', openFirst = false } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item, i) => (
      <div
        id={`${idPrefix}-${i + 1}`}
        class:list={['faq-item', 'reveal', { 'is-open': openFirst && i === 0 }]}
      >
        <button
          type="button"
          class="faq-question"
          aria-expanded={openFirst && i === 0 ? 'true' : 'false'}
        >
          <span>{item.q}</span>
          <span class="faq-icon" aria-hidden="true" />
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p>{item.a}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>
