---
interface Props {
  /** Position in a real sequence (process steps, chapters); omit otherwise. */
  index?: number;
}
const { index } = Astro.props;
---

<p class="label">
  {index !== undefined && <span class="index">{String(index).padStart(2, '0')}</span>}
  <slot />
</p>

<style>
  .label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
  }
  .label::before {
    content: '';
    align-self: center;
    width: var(--space-5);
    border-top: 1px solid currentColor;
  }
  .index {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
</style>
