---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['tag', className]}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border: var(--hairline);
    border-radius: var(--radius);
    background-color: var(--bg-raised);
    color: var(--fg);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
  }
</style>
