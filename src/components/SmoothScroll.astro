---
// Lenis smooth scrolling and one-time reveal on entering the viewport.
// Both are skipped with reduced motion; without JavaScript nothing is hidden.
---

<script>
  import Lenis from 'lenis';

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Same offsets as scroll-padding in base.css: clear of the top pill on desktop.
    new Lenis({ autoRaf: true, anchors: { offset: innerWidth >= 1024 ? -96 : -16 } });

    // The observer's first report says where each element is, without forcing
    // a synchronous layout at start-up. Only elements below the fold animate;
    // the first screen is never hidden.
    const seen = new WeakSet<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting, boundingClientRect } of entries) {
          if (!seen.has(target)) {
            seen.add(target);
            if (!isIntersecting && boundingClientRect.top > innerHeight) {
              target.classList.add('will-reveal');
            } else {
              observer.unobserve(target);
            }
          } else if (isIntersecting) {
            target.classList.add('is-revealed');
            observer.unobserve(target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    document.querySelectorAll('[data-reveal]').forEach((item) => observer.observe(item));
  }
</script>

<style is:global>
  html.lenis,
  html.lenis body {
    height: auto;
  }

  .lenis:not(.lenis-autoToggle).lenis-stopped {
    overflow: clip;
  }

  .will-reveal {
    opacity: 0;
    translate: 0 1.5rem;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      translate var(--dur-slow) var(--ease-out);
  }

  .will-reveal.is-revealed {
    opacity: 1;
    translate: 0;
  }
</style>
