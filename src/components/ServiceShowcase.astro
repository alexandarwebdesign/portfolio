---
// Services with a picture for each: picture and text side by side on
// desktop, picture above the text on phones. The pictures are illustrations
// from real work, so they are decorative (alt="") and the text says
// everything.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  items: { title: string; text: string; image: ImageMetadata }[];
}

const { items } = Astro.props;
const shapes = ['circle', 'triangle', 'hexagon'] as const;
const sizesInline = '(width >= 64rem) 50vw, 92vw';
---

<div>
  <ol class="rows">
    {
      items.map((item, i) => (
        <li class="row">
          <span class="inline" aria-hidden="true">
            <Picture
              src={item.image}
              formats={['avif', 'webp']}
              widths={[640, 1080, 1600]}
              sizes={sizesInline}
              alt=""
              loading="lazy"
            />
          </span>
          <div class="text" data-reveal>
            <div class="top">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <ServiceIcon shape={shapes[i % shapes.length]} />
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .rows {
    display: grid;
    gap: var(--section-head);
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    gap: var(--stack);
  }

  .inline {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background-color: var(--bg-sunken);
  }

  .inline :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .inline :global(img) {
    aspect-ratio: 16 / 10;
  }

  .text {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .index {
    color: var(--accent);
    font-size: var(--text-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .top :global(.service-icon) {
    width: 3rem;
  }

  h3 {
    font-size: var(--text-heading);
  }

  p {
    max-width: var(--measure);
    color: var(--fg-muted);
  }

  /* Desktop: picture left, text right, per row. */
  @media (width >= 64rem) {
    .row {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      column-gap: var(--column-gap);
      align-items: center;
    }

    .inline {
      grid-column: 1 / span 7;
    }

    .text {
      grid-column: 9 / -1;
    }
  }
</style>
