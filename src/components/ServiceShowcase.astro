---
// Services with a picture for each. Desktop with scroll-driven animations: one
// large picture stays pinned on the left and cross-fades to the next service
// as its row scrolls through the middle of the screen. Phones, browsers
// without scroll timelines and reduced motion: each row carries its own
// picture. The pictures are illustrations from real work, so they are
// decorative (alt="") and the text says everything.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  items: { title: string; text: string; image: ImageMetadata }[];
}

const { items } = Astro.props;
const shapes = ['circle', 'triangle', 'hexagon'] as const;
const sizesPinned = '(width >= 104rem) 58rem, 55vw';
const sizesInline = '(width >= 64rem) 50vw, 92vw';
---

<div class="showcase" style={`--count: ${items.length}`}>
  <div class="pinned" aria-hidden="true">
    <div class="stage">
      {
        items.map((item, i) => (
          <Picture
            src={item.image}
            formats={['avif', 'webp']}
            widths={[800, 1200, 1600]}
            sizes={sizesPinned}
            alt=""
            loading="lazy"
            class={`slide slide-${i + 1}`}
          />
        ))
      }
    </div>
  </div>
  <ol class="rows">
    {
      items.map((item, i) => (
        <li class={`row row-${i + 1}`}>
          <span class="inline reveal-media" aria-hidden="true">
            <Picture
              src={item.image}
              formats={['avif', 'webp']}
              widths={[640, 1080, 1600]}
              sizes={sizesInline}
              alt=""
              loading="lazy"
            />
          </span>
          <div class="text" data-reveal>
            <div class="top">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <ServiceIcon shape={shapes[i % shapes.length]} />
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .rows {
    display: grid;
    gap: var(--section-head);
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    gap: var(--stack);
  }

  .inline {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background-color: var(--bg-sunken);
  }

  .inline :global(img),
  .stage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .inline :global(img) {
    aspect-ratio: 16 / 10;
  }

  .text {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .index {
    color: var(--accent);
    font-size: var(--text-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .top :global(.service-icon) {
    width: 3rem;
  }

  h3 {
    font-size: var(--text-heading);
  }

  p {
    max-width: var(--measure);
    color: var(--fg-muted);
  }

  .pinned {
    display: none;
  }

  /* Desktop without the pinned version: picture left, text right, per row. */
  @media (width >= 64rem) {
    .row {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      column-gap: var(--column-gap);
      align-items: center;
    }

    .inline {
      grid-column: 1 / span 7;
    }

    .text {
      grid-column: 9 / -1;
    }
  }

  /* Desktop, pinned: one picture that changes while the rows scroll past. */
  @supports (animation-timeline: view()) {
    @media (width >= 64rem) and (prefers-reduced-motion: no-preference) {
      .showcase {
        display: grid;
        grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
        column-gap: var(--column-gap);
        timeline-scope: --service-1, --service-2, --service-3;
      }

      .pinned {
        display: block;
        grid-column: 1 / span 7;
        grid-row: 1;
      }

      .stage {
        position: sticky;
        top: calc(50svh - 32svh);
        height: 64svh;
        overflow: hidden;
        border-radius: var(--radius);
        background-color: var(--bg-sunken);
      }

      .stage :global(.slide) {
        position: absolute;
        inset: 0;
      }

      .rows {
        grid-column: 9 / -1;
        grid-row: 1;
        gap: 0;
      }

      /* Each row takes most of a screen, so every picture gets its moment. */
      .row {
        display: flex;
        align-items: center;
        min-height: 80svh;
      }

      .inline {
        display: none;
      }

      .row-1 {
        view-timeline: --service-1 block;
      }

      .row-2 {
        view-timeline: --service-2 block;
      }

      .row-3 {
        view-timeline: --service-3 block;
      }

      .stage :global(.slide) {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-range: cover 20% cover 80%;
      }

      .stage :global(.slide-1) {
        animation-name: slide-first;
        animation-timeline: --service-1;
      }

      .stage :global(.slide-2) {
        animation-name: slide-middle;
        animation-timeline: --service-2;
      }

      .stage :global(.slide-3) {
        animation-name: slide-last;
        animation-timeline: --service-3;
      }

      /* The first picture is there from the start; the last one stays. */
      @keyframes slide-first {
        0%,
        80% {
          opacity: 1;
          transform: none;
        }

        100% {
          opacity: 0;
          transform: scale(1.04);
        }
      }

      @keyframes slide-middle {
        0% {
          opacity: 0;
          transform: scale(1.08);
        }

        20%,
        80% {
          opacity: 1;
          transform: none;
        }

        100% {
          opacity: 0;
          transform: scale(1.04);
        }
      }

      @keyframes slide-last {
        0% {
          opacity: 0;
          transform: scale(1.08);
        }

        20%,
        100% {
          opacity: 1;
          transform: none;
        }
      }
    }
  }
</style>
