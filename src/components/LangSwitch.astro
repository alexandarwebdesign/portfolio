---
import type { Lang } from '../i18n/ui';

interface Props {
  /** Language of the target page. */
  lang: Lang;
  href: string;
}

const names: Record<Lang, { short: string; full: string }> = {
  bg: { short: 'БГ', full: 'Български' },
  en: { short: 'EN', full: 'English' },
};
const { lang, href } = Astro.props;
const name = names[lang];
---

<a class="lang" {href} hreflang={lang} {lang}>
  {name.short}<span class="visually-hidden"> {name.full}</span>
</a>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--target);
    min-height: var(--target);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .lang:hover {
    background-color: var(--line);
  }
</style>
