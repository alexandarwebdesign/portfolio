---
// Switches to the other language with that language's flag. The full name is
// the accessible label, so the flag is decoration for sighted users only.
import type { Lang } from '../i18n/ui';

interface Props {
  /** Language of the target page. */
  lang: Lang;
  href: string;
}

const names: Record<Lang, string> = {
  bg: 'Български',
  en: 'English',
};
const { lang, href } = Astro.props;
---

<a class="lang" {href} hreflang={lang} {lang} title={names[lang]}>
  {
    lang === 'bg' ? (
      <svg class="flag" viewBox="0 0 24 16" aria-hidden="true">
        <rect width="24" height="16" fill="#f5f5f5" />
        <rect y="5.333" width="24" height="5.334" fill="#00966e" />
        <rect y="10.667" width="24" height="5.333" fill="#d62612" />
      </svg>
    ) : (
      <svg class="flag" viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="60" height="30" fill="#012169" />
        <path d="M0 0l60 30M60 0L0 30" stroke="#f5f5f5" stroke-width="6" />
        <path d="M0 0l60 30M60 0L0 30" stroke="#c8102e" stroke-width="2" />
        <path d="M30 0v30M0 15h60" stroke="#f5f5f5" stroke-width="10" />
        <path d="M30 0v30M0 15h60" stroke="#c8102e" stroke-width="6" />
      </svg>
    )
  }
  <span class="visually-hidden">{names[lang]}</span>
</a>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--target);
    min-height: var(--target);
    border-radius: var(--radius);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .lang:hover {
    background-color: var(--line);
  }
  .flag {
    overflow: hidden;
    width: 1.5rem; /* 24 × 16 */
    height: 1rem;
    border-radius: var(--radius-sm);
    outline: 1px solid var(--line);
    outline-offset: -1px;
    transition: scale var(--dur-fast) var(--ease-out);
  }
  .lang:hover .flag {
    scale: 1.08;
  }
</style>
