---
// Glass navigation. Desktop: name on the left, the glass bar with the pages in
// the middle, the call to action on the right. Phones and tablets: the name at
// the top, and a bar at the bottom (thumb reach) with the menu and the call to
// action.
//
// While the hero's own button is on screen, the header button is secondary so
// the page never shows two primary buttons at once; when the hero button
// leaves the screen, it becomes the primary button (script below).
import Button from './Button.astro';
import LangSwitch from './LangSwitch.astro';
import { ui, type Lang } from '../i18n/ui';
import { pathFor, type RouteId } from '../i18n/routes';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  route: RouteId;
}

const { lang, route } = Astro.props;
const t = ui[lang];
const home = pathFor('home', lang)!;
const homeHash = (hash: string) => (home === '/' ? `/${hash}` : `${home}${hash}`);

// The call to action is the way to contact, so there is no separate link.
const links = [
  { href: homeHash('#work'), label: t.nav.work, current: false },
  { href: pathFor('about', lang)!, label: t.nav.about, current: route === 'about' },
  ...(lang === 'bg'
    ? [{ href: pathFor('uslugi', 'bg')!, label: t.nav.services, current: route === 'uslugi' }]
    : []),
];

// /uslugi has its own form; every other page goes to the one on the home page.
const ctaHref = route === 'uslugi' ? '#contact' : homeHash('#contact');
// Pages with a hero start with the secondary style (see the script).
const hasHero = route === 'home' || route === 'uslugi';
const ctaVariant = hasHero ? 'secondary' : 'primary';

// The other language: the same page when it exists, otherwise that language's home.
const otherLang: Lang = lang === 'bg' ? 'en' : 'bg';
const otherRoute = route === 'notFound' ? 'home' : route;
const otherHref = pathFor(otherRoute, otherLang) ?? pathFor('home', otherLang)!;
---

<header class="site-header">
  <a class="brand glass" href={home} aria-current={route === 'home' ? 'page' : undefined}>
    <svg width="20" height="21" viewBox="0 0 15 16" fill="none" aria-hidden="true">
      <path
        d="M2.99 15.33c-.95 0-1.72-.8-1.72-1.79V6.35c0-.54.24-1.06.65-1.4L6.64 1.02a1.68 1.68 0 0 1 2.15 0l4.73 3.93c.41.34.64.86.64 1.4v7.19c0 .99-.77 1.79-1.72 1.79H2.99Z"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M5.7 15.33v-4.49c0-.43.17-.85.47-1.16.3-.3.71-.47 1.14-.47h.81c.43 0 .84.17 1.14.47.3.31.47.73.47 1.16v4.49"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span class="name">{site.name[lang]}</span>
  </a>
  <nav class="bar glass" aria-label={t.nav.label}>
    <button class="menu-button" type="button" popovertarget="site-menu">
      {t.nav.menu}
    </button>
    <ul class="menu" id="site-menu" popover>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="lang-item">
        <LangSwitch lang={otherLang} href={otherHref} />
      </li>
    </ul>
    <Button class="cta" href={ctaHref} variant={ctaVariant} data-header-cta>{t.cta}</Button>
  </nav>
</header>

<script>
  // Close the mobile menu after choosing a link, which may only change the #hash.
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest('a') &&
      menu.matches(':popover-open')
    ) {
      menu.hidePopover();
    }
  });

  // Secondary while the hero button is visible, primary once it has left.
  const cta = document.querySelector('[data-header-cta]');
  const heroCta = document.querySelector('[data-hero-cta]');
  if (cta && heroCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const heroVisible = entry.isIntersecting;
      cta.classList.toggle('secondary', heroVisible);
      cta.classList.toggle('primary', !heroVisible);
    }).observe(heroCta);
  }
</script>

<style>
  @property --shine {
    syntax: '<angle>';
    initial-value: 156deg;
    inherits: false;
  }

  @keyframes shine-rotate {
    to {
      --shine: 516deg;
    }
  }

  .site-header {
    --glass: rgb(247 247 247 / 0.55);

    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    padding: var(--space-4) var(--margin);
    color: var(--ink);
    pointer-events: none;
  }

  .site-header > * {
    pointer-events: auto;
  }

  /*
   * Glass (the old "Espacio" recipe), neutral. The fill is 55 % so the links
   * keep AA contrast when the bar passes over the dark sections and images.
   */
  .glass {
    position: relative;
    border-radius: var(--radius);
    background: var(--glass);
    backdrop-filter: blur(12px) saturate(1.4);
  }

  /* Rim light that slowly travels around the edge. */
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid transparent;
    border-radius: inherit;
    background: linear-gradient(
        var(--shine),
        rgb(247 247 247 / 0.6) 2%,
        rgb(247 247 247 / 0.001) 40%,
        rgb(247 247 247 / 0.001) 55%,
        rgb(247 247 247 / 0.2) 93%
      )
      border-box;
    mask:
      linear-gradient(#fff 0 0) padding-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    animation: shine-rotate 8s linear infinite;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding-inline: 1.125rem 1.25rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .brand svg {
    flex: none;
  }

  .brand:hover {
    color: var(--cobalt);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1);
  }

  .menu-button {
    min-height: var(--target);
    padding-inline: var(--space-5);
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--ink);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .menu {
    list-style: none;
    padding: 0;
  }

  .menu a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--target);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .menu a:hover {
    color: var(--cobalt);
  }

  /* The secondary state sits on glass so it stays readable over anything. */
  .site-header :global(.cta.secondary) {
    background: var(--glass);
    backdrop-filter: blur(12px);
    color: var(--ink);
  }

  .site-header :global(.cta.secondary:hover) {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--mist);
  }

  /* Mobile and tablet: the bar sits at the bottom, in thumb reach. */
  @media (width < 64rem) {
    .bar {
      position: fixed;
      inset-inline: var(--margin);
      bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
      max-width: 28rem;
      margin-inline: auto;
    }

    /* Keeps the BG label on one line at 360px. */
    .bar :global(.cta) {
      flex: 1;
      padding-inline: var(--space-4);
      white-space: nowrap;
    }

    /* Inside the bar the glass is already there. */
    .site-header :global(.bar .cta.secondary) {
      background: none;
      backdrop-filter: none;
    }

    .menu:popover-open {
      position: fixed;
      inset: auto var(--margin) calc(var(--space-3) + env(safe-area-inset-bottom, 0px) + 4.5rem);
      width: auto;
      max-width: 28rem;
      margin-inline: auto;
      display: grid;
      gap: var(--space-1);
      margin-block: 0;
      padding: var(--space-5);
      border: var(--hairline);
      border-radius: var(--radius);
      background-color: var(--paper-raised);
      color: var(--ink);
    }

    .menu a {
      font-family: var(--font-display);
      font-size: var(--text-title);
      letter-spacing: var(--tracking-display);
    }

    .menu a[aria-current='page'] {
      text-decoration: underline;
    }

    .lang-item {
      padding-top: var(--space-3);
      border-top: var(--hairline);
    }
  }

  /* Desktop: name left, page links centred, call to action right (24 px from the top). */
  @media (width >= 64rem) {
    .site-header {
      position: fixed;
      inset: 1.5rem 0 auto;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--space-4);
      max-width: calc(var(--container) + 2 * var(--margin));
      margin-inline: auto;
      padding: 0 var(--margin);
    }

    .brand {
      justify-self: start;
      min-height: 4rem; /* 64 */
    }

    /* The nav's children join the header grid: links centred, button right. */
    .bar {
      display: contents;
    }

    .bar.glass::after {
      content: none;
    }

    .menu-button {
      display: none;
    }

    /* Always shown inline; the popover only applies to small screens. */
    .menu {
      position: relative;
      display: flex;
      align-items: center;
      gap: 4px;
      inset: auto;
      width: auto;
      height: auto;
      margin: 0;
      padding: var(--space-2); /* 8 */
      overflow: visible;
      border: 0;
      border-radius: var(--radius);
      background: var(--glass);
      backdrop-filter: blur(12px) saturate(1.4);
      color: inherit;
    }

    .menu::after {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid transparent;
      border-radius: inherit;
      background: linear-gradient(
          var(--shine),
          rgb(247 247 247 / 0.6) 2%,
          rgb(247 247 247 / 0.001) 40%,
          rgb(247 247 247 / 0.001) 55%,
          rgb(247 247 247 / 0.2) 93%
        )
        border-box;
      mask:
        linear-gradient(#fff 0 0) padding-box,
        linear-gradient(#fff 0 0);
      mask-composite: exclude;
      pointer-events: none;
      animation: shine-rotate 8s linear infinite;
    }

    .menu a {
      padding: 0.75rem 1.5rem; /* 12 × 24 */
      border-radius: var(--radius);
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.25;
    }

    /* Active page: a small accent dot under the label. */
    .menu a[aria-current='page']::after {
      content: '';
      position: absolute;
      bottom: 3px;
      left: 50%;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background-color: var(--cobalt);
      translate: -50% 0;
    }

    .lang-item :global(.lang:hover) {
      background: none;
    }

    .bar :global(.cta) {
      justify-self: end;
      min-height: 4rem; /* same height as the name */
      padding-inline: var(--space-5);
      font-size: 1rem;
    }
  }
</style>
