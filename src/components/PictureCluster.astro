---
// The closing call to action: the title and the button, and under them one row of six website
// concepts. From 900 px wide, with motion and scroll-driven animation, the row slides sideways as
// it scrolls into view (CSS only); otherwise it is a row you swipe.
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import s1 from '../assets/images/marquee/studio-01.jpg';
import s2 from '../assets/images/marquee/studio-02.jpg';
import s3 from '../assets/images/marquee/studio-03.jpg';
import s4 from '../assets/images/marquee/studio-04.jpg';
import s5 from '../assets/images/marquee/studio-05.jpg';
import s6 from '../assets/images/marquee/studio-06.jpg';

interface Props {
  title: string;
  cta: string;
}

const { title, cta } = Astro.props;
const pictures = [s1, s2, s3, s4, s5, s6];
---

<section class="cluster stage" aria-labelledby="cluster-title">
  <div class="container cluster__center reveal">
    <h2 id="cluster-title" class="cluster__title">{title}</h2>
    <Button href="#contact" data-focus-target="#name">{cta}</Button>
  </div>
  <div class="cluster__track" aria-hidden="true">
    <ul class="cluster__pictures">
      {
        pictures.map((image) => (
          <li class="cluster__picture">
            <Picture
              src={image}
              formats={['avif', 'webp']}
              widths={[500, 800, 1080]}
              sizes="(max-width: 900px) 70vw, 24vw"
              alt=""
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
