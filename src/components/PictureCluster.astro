---
// The closing section, kept short: the title, six designs in two rows of different widths (a wide,
// a regular and a narrow one, mirrored in the second row, all of one height per row), then the
// button. No labels, no pinning, no scroll animation: the designs come in with the usual reveal.
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import s1 from '../assets/images/marquee/studio-01.jpg';
import s2 from '../assets/images/marquee/studio-02.jpg';
import s3 from '../assets/images/marquee/studio-03.jpg';
import s4 from '../assets/images/marquee/studio-04.jpg';
import s5 from '../assets/images/marquee/studio-05.jpg';
import s6 from '../assets/images/marquee/studio-06.jpg';

interface Props {
  title: string;
  cta: string;
}

const { title, cta } = Astro.props;
// Row 1: wide, regular, narrow. Row 2: narrow, regular, wide (see .cluster__pictures).
const pictures = [s1, s2, s6, s3, s4, s5];
---

<section class="cluster stage" aria-labelledby="cluster-title">
  <div class="container">
    <h2 id="cluster-title" class="cluster__title reveal">{title}</h2>
    <ul class="cluster__pictures" aria-hidden="true">
      {
        pictures.map((image) => (
          <li class="cluster__picture reveal">
            <Picture
              src={image}
              formats={['avif', 'webp']}
              widths={[800, 1100, 1400]}
              sizes="(max-width: 700px) 100vw, 48vw"
              alt=""
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
    <div class="cluster__cta reveal">
      <Button href="#contact" data-focus-target="#name">{cta}</Button>
    </div>
  </div>
</section>
