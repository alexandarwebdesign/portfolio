---
// The original service marks: a dotted outline that travels and floats; when
// the row is hovered (the site script forwards the hover) the dots join into
// a solid accent line. SMIL, paused with reduced motion by the site script.
interface Props {
  shape: 'circle' | 'triangle' | 'hexagon';
}

const { shape } = Astro.props;
const viewBox = { circle: '0 0 800 800', triangle: '0 0 850 850', hexagon: '0 0 800 900' }[shape];
const paths = {
  triangle:
    'M720.5 401.598C733.833 409.296 733.833 428.541 720.5 436.24 L149.5 765.904C136.167 773.602 119.5 763.98 119.5 748.582 L119.5 89.255C119.5 73.8576 136.167 64.2351 149.5 71.9332 L720.5 401.598Z',
  hexagon:
    'M410.603 9.42265C398.603 2.49444 383.397 2.49444 371.397 9.42265 L36.3975 202.82C24.3975 209.749 16.8975 222.739 16.8975 236.596 L16.8975 623.404C16.8975 637.261 24.3975 650.251 36.3975 657.18 L371.397 850.577C383.397 857.506 398.603 857.506 410.603 850.577 L745.603 657.18C757.603 650.251 765.103 637.261 765.103 623.404 L765.103 236.596C765.103 222.739 757.603 209.749 745.603 202.82 L410.603 9.42265Z',
};
const accent = '#3346dc';
const ink = '#464646';
// Hover begins on the shape itself (paths) or on a wide invisible ring (circle).
const on = shape === 'circle' ? 'hoverAreaEllipse.mouseover' : 'mouseover';
const off = shape === 'circle' ? 'hoverAreaEllipse.mouseout' : 'mouseout';
---

<div class="service-icon" aria-hidden="true">
  <svg {viewBox} width="100%" height="100%">
    <g>
      <animateTransform
        attributeName="transform"
        type="translate"
        values="0,0; 0,-15; 0,0"
        dur="4.64s"
        calcMode="spline"
        keySplines="0.4 0 0.6 1; 0.4 0 0.6 1"
        keyTimes="0; 0.5; 1"
        repeatCount="indefinite"></animateTransform>
      {
        shape === 'circle' && (
          <circle
            id="hoverAreaEllipse"
            data-hover-target
            cx="400"
            cy="400"
            r="380"
            stroke="transparent"
            stroke-width="80"
            fill="transparent"
          />
        )
      }
      {
        shape === 'circle' ? (
          <circle
            cx="400"
            cy="400"
            r="380"
            stroke={ink}
            stroke-width="12"
            stroke-linecap="round"
            fill="none"
            pathLength="100"
            stroke-dasharray="1 8"
            pointer-events="none"
          >
            <animate
              attributeName="stroke-dashoffset"
              values="100; 0"
              dur="7s"
              repeatCount="indefinite"
            />
            <animate
              attributeName="stroke-dasharray"
              values="1 8; 100 0"
              dur="0.4s"
              begin={on}
              fill="freeze"
            />
            <animate
              attributeName="stroke-dasharray"
              values="100 0; 1 8"
              dur="0.4s"
              begin={off}
              fill="freeze"
            />
            <animate
              attributeName="stroke"
              values={`${ink}; ${accent}`}
              dur="0.4s"
              begin={on}
              fill="freeze"
            />
            <animate
              attributeName="stroke"
              values={`${accent}; ${ink}`}
              dur="0.4s"
              begin={off}
              fill="freeze"
            />
            <animate
              attributeName="stroke-width"
              values="12; 18"
              dur="0.4s"
              begin={on}
              fill="freeze"
            />
            <animate
              attributeName="stroke-width"
              values="18; 12"
              dur="0.4s"
              begin={off}
              fill="freeze"
            />
          </circle>
        ) : (
          <path
            d={paths[shape]}
            data-hover-target
            stroke={ink}
            stroke-width="12"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="transparent"
            pathLength="100"
            stroke-dasharray="1 8"
          >
            <animate
              attributeName="stroke-dashoffset"
              values="100; 0"
              dur="7s"
              repeatCount="indefinite"
            />
            <animate
              attributeName="stroke-dasharray"
              values="1 8; 100 0"
              dur="0.4s"
              begin={on}
              fill="freeze"
            />
            <animate
              attributeName="stroke-dasharray"
              values="100 0; 1 8"
              dur="0.4s"
              begin={off}
              fill="freeze"
            />
            <animate
              attributeName="stroke"
              values={`${ink}; ${accent}`}
              dur="0.4s"
              begin={on}
              fill="freeze"
            />
            <animate
              attributeName="stroke"
              values={`${accent}; ${ink}`}
              dur="0.4s"
              begin={off}
              fill="freeze"
            />
            <animate
              attributeName="stroke-width"
              values="12; 18"
              dur="0.4s"
              begin={on}
              fill="freeze"
            />
            <animate
              attributeName="stroke-width"
              values="18; 12"
              dur="0.4s"
              begin={off}
              fill="freeze"
            />
          </path>
        )
      }
    </g>
  </svg>
</div>
