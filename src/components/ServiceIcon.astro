---
// The original service marks: a dotted outline that travels around a shape
// and floats; when its row is hovered the dots join into a solid accent line.
// CSS animations (not SMIL), so reduced motion stops them.
interface Props {
  shape: 'circle' | 'triangle' | 'hexagon';
}

const { shape } = Astro.props;
const viewBox = { circle: '0 0 800 800', triangle: '0 0 850 850', hexagon: '0 0 800 900' }[shape];
---

<span class="service-icon" aria-hidden="true">
  <svg {viewBox}>
    <g class="float">
      {shape === 'circle' && <circle class="line" cx="400" cy="400" r="380" pathLength="100" />}
      {
        shape === 'triangle' && (
          <path
            class="line"
            pathLength="100"
            d="M720.5 401.598C733.833 409.296 733.833 428.541 720.5 436.24 L149.5 765.904C136.167 773.602 119.5 763.98 119.5 748.582 L119.5 89.255C119.5 73.8576 136.167 64.2351 149.5 71.9332 L720.5 401.598Z"
          />
        )
      }
      {
        shape === 'hexagon' && (
          <path
            class="line"
            pathLength="100"
            d="M410.603 9.42265C398.603 2.49444 383.397 2.49444 371.397 9.42265 L36.3975 202.82C24.3975 209.749 16.8975 222.739 16.8975 236.596 L16.8975 623.404C16.8975 637.261 24.3975 650.251 36.3975 657.18 L371.397 850.577C383.397 857.506 398.603 857.506 410.603 850.577 L745.603 657.18C757.603 650.251 765.103 637.261 765.103 623.404 L765.103 236.596C765.103 222.739 757.603 209.749 745.603 202.82 L410.603 9.42265Z"
          />
        )
      }
    </g>
  </svg>
</span>

<style>
  .service-icon {
    display: flex;
    justify-content: flex-end;
    width: clamp(5.5rem, 9vw, 8.5rem); /* 88 → 136 */
    aspect-ratio: 1;
    color: #464646;
    opacity: 0.7;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .float {
    animation: float 4.64s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 12;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 8;
    animation: travel 7s linear infinite;
    transition:
      stroke-dasharray 0.4s var(--ease-out),
      stroke-width 0.4s var(--ease-out),
      stroke 0.4s var(--ease-out);
  }

  /* The row (any ancestor li) is the hover target. */
  :global(li:hover) .line {
    stroke: var(--accent);
    stroke-width: 18;
    stroke-dasharray: 100 0;
  }

  @keyframes travel {
    from {
      stroke-dashoffset: 100;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes float {
    50% {
      translate: 0 -15px;
    }
  }
</style>
