---
import { Picture } from 'astro:assets';
import Tag from './Tag.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  category: string;
  year: string;
  image: ImageMetadata;
  /** Case study URL; without one the row shows its status instead of linking. */
  href?: string;
  status?: string;
}

const { name, category, year, image, href, status } = Astro.props;
const Tagname = href ? 'a' : 'div';
---

<li class="project-row">
  <Tagname class="row" href={href}>
    <span class="category">{category}</span>
    <h3 class="name">{name}</h3>
    <span class="meta">
      {status && <Tag>{status}</Tag>}
      <span class="year">{year}</span>
    </span>
    <Picture
      src={image}
      formats={['avif', 'webp']}
      widths={[480, 800]}
      sizes="(width >= 64rem) 22rem, 100vw"
      alt=""
      loading="lazy"
    />
  </Tagname>
</li>

<script>
  // Moves the desktop preview with the cursor (CSS decides whether it shows).
  for (const row of document.querySelectorAll<HTMLElement>('.project-row .row')) {
    row.addEventListener('pointermove', (event) => {
      const box = row.getBoundingClientRect();
      row.style.setProperty('--x', `${event.clientX - box.left}px`);
      row.style.setProperty('--y', `${event.clientY - box.top}px`);
    });
  }
</script>

<style>
  .project-row {
    border-top: var(--hairline);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'name meta'
      'category category'
      'preview preview';
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-5);
    color: inherit;
    text-decoration: none;
  }

  .name {
    grid-area: name;
    font-size: var(--text-heading);
    line-height: 1;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .category {
    grid-area: category;
    color: var(--fg-muted);
    font-size: var(--text-small);
  }

  .meta {
    grid-area: meta;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  .row :global(picture) {
    grid-area: preview;
  }

  .row :global(img) {
    width: 100%;
    max-width: 36rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: var(--space-3);
  }

  a.row:hover .name,
  a.row:focus-visible .name {
    color: var(--accent);
  }

  /* Tablets and touch screens: text on the left, the image on the right. */
  @media (width >= 48rem) {
    .row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 1fr) minmax(0, 6fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'name . preview'
        'category . preview'
        'meta . preview';
      padding-block: var(--stack);
    }

    .meta {
      align-self: start;
    }

    .row :global(img) {
      max-width: none;
      margin-top: 0;
    }
  }

  /*
   * Desktop with a mouse: one wide row (category · name · year) and the image
   * follows the cursor. The image is a preview of what is already in the row,
   * so nothing is hover-only.
   */
  @media (width >= 64rem) and (hover: hover) and (pointer: fine) {
    .row {
      grid-template-columns: 1fr auto 1fr;
      grid-template-rows: auto;
      grid-template-areas: 'category name meta';
      align-items: center;
      padding-block: var(--space-6);
    }

    .name {
      font-size: var(--text-display);
      text-align: center;
    }

    .meta {
      justify-content: flex-end;
    }

    .row :global(img) {
      position: absolute;
      left: var(--x, 50%);
      top: var(--y, 50%);
      z-index: 2;
      width: 22rem;
      margin: 0;
      pointer-events: none;
      opacity: 0;
      scale: 0.92;
      translate: -50% -50%;
      transition:
        opacity var(--dur) var(--ease-out),
        scale var(--dur) var(--ease-out);
    }

    .row:hover :global(img),
    .row:focus-visible :global(img) {
      opacity: 1;
      scale: 1;
    }

    /* Keyboard focus has no cursor: the preview sits beside the name. */
    .row:focus-visible :global(img) {
      left: 72%;
      top: 50%;
    }
  }
</style>
