---
// Three phones side by side, each with a short note; the middle one may play
// a video. Phones and notes stay still so the text can be read.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Phone {
  image?: ImageMetadata;
  video?: { src: string; poster: string; width: number; height: number };
  alt: string;
  title: string;
  text: string;
}

interface Props {
  label: string;
  phones: Phone[];
}

const { label, phones } = Astro.props;
---

<div class="case-block case-block--device case-block--bare" style="--case-tint:#e4e4e4;">
  <section class="section single-block block-mobile-devices block_6 bmd-birse" aria-label={label}>
    <div class="mobile-devices-row">
      {
        phones.map((phone, i) => (
          <div class="mobile-col">
            <div class:list={['mobile-device', { 'video-toggle': phone.video }]}>
              {phone.video ? (
                <div class="mobile-screen">
                  <video
                    class="overlay screen-video"
                    poster={phone.video.poster}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    width={phone.video.width}
                    height={phone.video.height}
                    aria-label={phone.alt}
                  >
                    <source
                      src={`${phone.video.src}.av1.mp4`}
                      type='video/mp4; codecs="av01.0.05M.08"'
                    />
                    <source src={`${phone.video.src}.h264.mp4`} type="video/mp4" />
                  </video>
                </div>
              ) : (
                phone.image && (
                  <div class="mobile-screen mobile-screen--img">
                    <Picture
                      src={phone.image}
                      formats={['avif', 'webp']}
                      widths={[500, 786].filter((w) => w <= phone.image!.width)}
                      sizes="(max-width: 900px) 72vw, 392px"
                      alt={phone.alt}
                      class="mobile-screen-img"
                      loading="lazy"
                    />
                  </div>
                )
              )}
            </div>
            <div class="case-device-note">
              <h3>{phone.title}</h3>
              <p>{phone.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</div>
