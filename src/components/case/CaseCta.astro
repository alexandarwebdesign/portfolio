---
import Button from '../Button.astro';

interface Props {
  title: string;
  cta: string;
  href: string;
}

const { title, cta, href } = Astro.props;
---

<aside class="case-cta-block reveal" aria-labelledby="project-cta-heading">
  <p id="project-cta-heading" class="case-cta-eyebrow">{title}</p>
  <div class="case-cta-actions">
    <Button {href} class="case-cta-btn">{cta}</Button>
  </div>
</aside>
