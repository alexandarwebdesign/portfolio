---
// A full-bleed strip of website concepts. With scroll-driven animations the
// strip slides sideways as the page scrolls past it; without them, and with
// reduced motion, it is a row you swipe or scroll (snap per image).
import { Picture } from 'astro:assets';
import SectionLabel from './SectionLabel.astro';
import { concepts, conceptsText } from '../data/concepts';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Surface of the section: the page colour or the lighter one. */
  raised?: boolean;
}

const { lang, raised = false } = Astro.props;
const t = conceptsText[lang];
const titleId = `concepts-title-${lang}`;
---

<section class:list={['section', 'concepts', { raised }]} aria-labelledby={titleId}>
  <div class="container">
    <header class="section-head head" data-reveal>
      <div>
        <SectionLabel>{t.label}</SectionLabel>
        <h2 id={titleId}>{t.title}</h2>
      </div>
      <p class="muted note">{t.note}</p>
    </header>
  </div>
  <div class="viewport" role="region" aria-labelledby={titleId} tabindex="0">
    <ul class="track">
      {
        concepts.map((concept) => (
          <li>
            <figure>
              <span class="frame">
                <Picture
                  src={concept.image}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(width >= 48rem) clamp(20rem, 38vw, 46rem), 82vw"
                  alt={t.alt(concept.name)}
                  loading="lazy"
                />
              </span>
              <figcaption>
                <span class="name">{concept.name}</span>
                <span class="category">{concept.category[lang]}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .concepts {
    overflow: clip;
  }

  .head {
    display: grid;
    gap: var(--stack);
    align-items: end;
  }

  .note {
    max-width: 28rem;
  }

  @media (width >= 64rem) {
    .head {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      column-gap: var(--column-gap);
    }

    .head > div {
      grid-column: 1 / span 7;
    }

    .note {
      grid-column: 9 / -1;
    }
  }

  /* Full bleed: out of the section's side margins, edge to edge. */
  .viewport {
    container-type: inline-size;
    margin-inline: calc(-1 * var(--margin));
  }

  .viewport:focus-visible {
    outline-offset: -2px;
  }

  .track {
    display: flex;
    gap: var(--column-gap);
    width: max-content;
    margin: 0;
    /* The first and last image line up with the container's edges. */
    padding: 0 max(var(--margin), (100cqw - var(--container)) / 2);
    list-style: none;
  }

  li {
    width: 82vw;
  }

  @media (width >= 48rem) {
    li {
      width: clamp(20rem, 38vw, 46rem);
    }
  }

  figure {
    display: grid;
    gap: var(--space-3);
  }

  .frame {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background-color: var(--bg-sunken);
  }

  .frame :global(img) {
    width: 100%;
    aspect-ratio: 3456 / 2234;
    object-fit: cover;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-small);
  }

  .name {
    font-weight: 600;
  }

  .category {
    color: var(--fg-muted);
  }

  /* Scrolling the page slides the strip from its first image to its last. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .track {
        animation-name: slide;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 5% cover 95%;
      }

      @keyframes slide {
        from {
          translate: 0 0;
        }

        to {
          translate: calc(-100% + 100cqw) 0;
        }
      }
    }
  }

  /* Otherwise: a row to swipe, one image at a time. */
  @supports not (animation-timeline: view()) {
    .viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(var(--margin), (100cqw - var(--container)) / 2);
      overscroll-behavior-x: contain;
    }

    li {
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(var(--margin), (100cqw - var(--container)) / 2);
      overscroll-behavior-x: contain;
    }

    li {
      scroll-snap-align: start;
    }
  }
</style>
