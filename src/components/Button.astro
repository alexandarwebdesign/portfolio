---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'secondary';
  /** large: the hero call to action of the original site. */
  size?: 'default' | 'large';
  arrow?: boolean;
} & (
  | ({ href: string } & Omit<HTMLAttributes<'a'>, 'href'>)
  | ({ href?: undefined } & HTMLAttributes<'button'>)
);

const {
  variant = 'primary',
  size = 'default',
  arrow = false,
  class: className,
  ...rest
} = Astro.props;
const classes = ['button', variant, { large: size === 'large' }, className];
---

{
  rest.href === undefined ? (
    <button class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
      {arrow && (
        <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      )}
    </button>
  ) : (
    <a class:list={classes} {...rest}>
      <slot />
      {arrow && (
        <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      )}
    </a>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: var(--space-2) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .primary {
    background-color: var(--accent);
    color: var(--on-accent);
  }
  .primary:hover {
    background-color: var(--fg);
    color: var(--bg);
  }
  .secondary {
    border-color: var(--line-strong);
    color: var(--fg);
  }
  .secondary:hover {
    border-color: var(--fg);
    background-color: var(--fg);
    color: var(--bg);
  }
  /* 18 px label, 18 × 36 px padding, soft accent shadow, lift on hover. */
  .large {
    padding: 1.125rem 2.25rem;
    font-size: 1.125rem;
    letter-spacing: 0.015rem; /* 0.24 px */
    line-height: 1.5;
    box-shadow:
      0 8px 18px rgb(51 70 220 / 0.2),
      inset 0 1px 0 rgb(255 255 255 / 0.16);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .large.primary:hover {
    background-color: #2737c4;
    color: var(--on-accent);
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 12px 24px rgb(51 70 220 / 0.26),
      inset 0 1px 0 rgb(255 255 255 / 0.2);
  }
  @media (width <= 37.5rem) {
    .large {
      padding: 0.875rem 1.75rem; /* 14 × 28 */
      font-size: 1rem;
    }
  }
  .large:active {
    transform: none;
    transition-duration: 80ms;
  }
  .arrow {
    flex: none;
    transition: translate var(--dur-fast) var(--ease-out);
  }
  .button:hover .arrow {
    translate: 3px 0;
  }
</style>
