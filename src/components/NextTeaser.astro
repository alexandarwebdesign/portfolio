---
// The original "next project" teaser: the name split around a small image
// that grows on hover.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  label: string;
  /** The name in two halves, left and right of the image. */
  left: string;
  right: string;
  image: ImageMetadata;
  ariaLabel: string;
}

const { href, label, left, right, image, ariaLabel } = Astro.props;
---

<section id="project-next-teaser" class="project-next-teaser-section">
  <div class="container">
    <a {href} class="project-next-teaser reveal" aria-label={ariaLabel}>
      <span class="project-next-teaser__label">{label}</span>
      <span class="project-next-teaser__layout">
        <span class="project-next-teaser__title project-next-teaser__title--left">{left}</span>
        <span class="project-next-teaser__media">
          <Picture
            src={image}
            formats={['avif', 'webp']}
            widths={[500, 800, 1080].filter((w) => w <= image.width)}
            sizes="(max-width: 900px) 60vw, 30vw"
            alt=""
            loading="lazy"
            class="project-next-teaser__image"
          />
        </span>
        <span class="project-next-teaser__title project-next-teaser__title--right">{right}</span>
      </span>
    </a>
  </div>
</section>
