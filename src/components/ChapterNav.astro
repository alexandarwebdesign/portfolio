---
interface Props {
  label: string;
  chapters: { id: string; label: string }[];
}

const { label, chapters } = Astro.props;
---

<!-- Long case studies read in parts: the current chapter is marked as you scroll. -->
<nav class="chapter-nav" aria-label={label}>
  <ol>
    {
      chapters.map((chapter, i) => (
        <li>
          <a href={`#${chapter.id}`}>
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            {chapter.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const nav = document.querySelector('.chapter-nav');
  const links = [...(nav?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
  const sections = links.map((link) => document.querySelector(link.hash)!);

  const mark = () => {
    // The current chapter is the last one whose top has passed a third of the screen.
    const line = innerHeight / 3;
    let current = 0;
    sections.forEach((section, i) => {
      if (section.getBoundingClientRect().top <= line) current = i;
    });
    if (links[current].hasAttribute('aria-current')) return;
    links.forEach((link, i) => {
      if (i === current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    // On small screens the list scrolls sideways: keep the current chapter visible.
    links[current].closest('ol')!.scrollLeft = links[current].offsetLeft - 16;
  };

  if (links.length) {
    let queued = false;
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          mark();
        });
      },
      { passive: true },
    );
    mark();
  }
</script>

<style>
  .chapter-nav {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-inline: calc(var(--margin) * -1);
    padding: var(--space-2) var(--margin);
    border-bottom: var(--hairline);
    background-color: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  ol {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding-inline: var(--space-3);
    border-radius: var(--radius);
    color: var(--fg-muted);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  a:hover {
    color: var(--fg);
  }

  a[aria-current] {
    background-color: var(--fg);
    color: var(--bg);
  }

  .index {
    font-variant-numeric: tabular-nums;
  }

  /* Desktop: a vertical list beside the text, clear of the top pill. */
  @media (width >= 64rem) {
    .chapter-nav {
      top: var(--top-clear);
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      backdrop-filter: none;
    }

    ol {
      flex-direction: column;
      overflow: visible;
    }

    a[aria-current] {
      background: none;
      color: var(--fg);
    }

    a[aria-current] .index {
      color: var(--accent);
    }

    a::before {
      content: '';
      width: var(--space-4);
      border-top: 1px solid currentColor;
      transition: width var(--dur) var(--ease-out);
    }

    a[aria-current]::before {
      width: var(--space-6);
    }
  }
</style>
