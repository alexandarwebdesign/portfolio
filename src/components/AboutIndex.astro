---
// The original about index: hairline rows with a mono key and a bold value,
// a small turning globe on "Based" and a pulsing green dot on "Status".
// CSS animations (not SMIL), so reduced motion stops them.
import type { Fact } from '../data/about';

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="about-index">
  {
    facts.map((fact) => (
      <div class="row">
        <dt>{fact.term}</dt>
        <dd>
          {fact.icon === 'globe' && (
            <span class="globe" aria-hidden="true">
              <span class="wrap">
                <span class="circle" />
                <span class="circle" />
                <span class="circle" />
                <span class="hor" />
                <span class="hor-middle" />
              </span>
            </span>
          )}
          {fact.icon === 'status' && (
            <svg class="status" viewBox="0 0 19 19" aria-hidden="true">
              <circle class="dot" cx="9.5" cy="9.5" r="1.5" />
              <circle class="ring r1" cx="9.5" cy="9.5" r="2.25" />
              <circle class="ring r2" cx="9.5" cy="9.5" r="4.25" />
              <circle class="ring r3" cx="9.5" cy="9.5" r="5.4" />
            </svg>
          )}
          <span>{fact.desc}</span>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .about-index {
    container-type: inline-size;
    border-top: var(--hairline);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: 1.25rem; /* 20 */
    border-bottom: var(--hairline);
  }

  /* Key left, value right once there is room for both on one line. */
  @container (width >= 26rem) {
    .row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-6);
    }

    dd {
      justify-content: flex-end;
      text-align: right;
    }
  }

  dt {
    flex-shrink: 0;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    font-size: clamp(1rem, 0.4vw + 0.9rem, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* Pulsing availability dot. */
  .status {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    overflow: visible;
  }

  .dot {
    fill: #1f9c44;
  }

  .ring {
    fill: none;
    stroke: #1f9c44;
    stroke-width: 0.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 2s ease-in-out infinite;
  }

  .r2 {
    animation-delay: 0.3s;
  }

  .r3 {
    stroke-width: 0.2;
    animation-delay: 0.6s;
  }

  @keyframes pulse {
    50% {
      opacity: 0.2;
      scale: 1.3;
    }
  }

  /*
   * Small turning globe. Its lines are drawn with hard inset box-shadows (no
   * blur, accent colour): strokes, not shadows.
   */
  .globe {
    position: relative;
    flex-shrink: 0;
    width: 2.125rem; /* 34 */
    height: 2.125rem;
    overflow: hidden;
    border-radius: 50%;
  }

  .wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--accent);
    transform: translate(-50%, -50%) rotate(30deg);
    animation: globe 5.4s var(--ease-out) infinite;
  }

  .circle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    box-shadow: inset 1.5px 0 0 1.5px var(--accent);
    transform: translate(-50%, -50%);
    animation: meridian 2.7s linear infinite;
  }

  .circle:nth-child(1) {
    animation-delay: -1.8s;
  }

  .circle:nth-child(2) {
    animation-delay: -0.9s;
  }

  .hor {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 55%;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--accent);
    transform: translate(-50%, -50%);
  }

  .hor-middle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 1.5px;
    background: var(--accent);
    transform: translate(-50%, -50%);
  }

  @keyframes globe {
    0%,
    100% {
      transform: translate(-50%, -50%) rotate(15deg);
    }

    50% {
      transform: translate(-50%, -50%) rotate(-15deg);
    }
  }

  @keyframes meridian {
    0% {
      width: 100%;
      border-radius: 50%;
      box-shadow: inset 1.5px 0 0 1.5px var(--accent);
    }

    49% {
      border-radius: 50%;
      background: transparent;
      box-shadow: inset 1.5px 0 0 1.5px var(--accent);
    }

    50% {
      width: 2px;
      border-radius: 0;
      background: var(--accent);
    }

    51% {
      border-radius: 50%;
      background: transparent;
      box-shadow: inset -1.5px 0 0 1.5px var(--accent);
    }

    100% {
      width: 100%;
      border-radius: 50%;
      box-shadow: inset -1.5px 0 0 1.5px var(--accent);
    }
  }
</style>
