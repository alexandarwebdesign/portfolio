---
import { Picture, getImage } from 'astro:assets';
import Base from './Base.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ChapterNav from '../components/ChapterNav.astro';
import UxNotes from '../components/UxNotes.astro';
import Gallery from '../components/Gallery.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import { ui, type Lang } from '../i18n/ui';
import { pathFor } from '../i18n/routes';
import type { CaseContent } from '../data/projects/types';
import { caseSchema } from '../data/schema';

interface Props {
  lang: Lang;
  route: 'birse' | 'forma';
  content: CaseContent;
}

const { lang, route, content } = Astro.props;
const t = ui[lang];
const home = pathFor('home', lang)!;
const workHref = home === '/' ? '/#work' : `${home}#work`;
const cover = await getImage({ src: content.hero.image, width: 1600, format: 'jpg' });
const schema = caseSchema(lang, route, pathFor(route, lang)!, content, cover.src);
---

<Base
  title={content.meta.title}
  description={content.meta.description}
  {route}
  {schema}
  crumb={content.name}
>
  <article class="case">
    <header class="hero">
      <div class="intro">
        <a class="back" href={workHref}>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M13 8H3M7 4 3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.5"
            ></path>
          </svg>
          {t.caseStudy.allWork}
        </a>
        <Tag>{content.status}</Tag>
        <h1>{content.name}</h1>
        <p class="lead">{content.lead}</p>
        <dl class="facts">
          {
            content.facts.map((fact) => (
              <div>
                <dt>{fact.term}</dt>
                <dd>{fact.desc}</dd>
              </div>
            ))
          }
        </dl>
        <Button href={content.live.href} variant="secondary" arrow>{content.live.label}</Button>
      </div>
      <Picture
        class="cover"
        src={content.hero.image}
        formats={['avif', 'webp']}
        widths={[640, 1080, 1600, 2400]}
        sizes="(width >= 100rem) 100rem, 100vw"
        alt={content.hero.alt}
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <div class="body">
      <ChapterNav
        label={t.caseStudy.chapters}
        chapters={content.chapters.map((c) => ({ id: c.id, label: c.label }))}
      />

      <div class="chapters">
        {
          content.chapters.map((chapter, i) => (
            <section id={chapter.id} class="chapter" aria-labelledby={`${chapter.id}-title`}>
              <div class="text">
                <SectionLabel index={i + 1}>{chapter.label}</SectionLabel>
                <h2 id={`${chapter.id}-title`}>{chapter.title}</h2>
                {chapter.text.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {chapter.list && (
                  <ul class="list">
                    {chapter.list.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
                {chapter.facts && (
                  <dl class="roles">
                    {chapter.facts.map((fact) => (
                      <div>
                        <dt>{fact.term}</dt>
                        <dd>{fact.desc}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
              {chapter.figures?.map((figure) =>
                figure.kind === 'notes' ? (
                  <UxNotes {lang} {...figure} />
                ) : figure.kind === 'gallery' ? (
                  <Gallery items={figure.items} narrow={figure.narrow} />
                ) : (
                  <video
                    class:list={['video', { narrow: figure.narrow }]}
                    width={figure.width}
                    height={figure.height}
                    poster={`${figure.src}-poster.webp`}
                    aria-label={figure.label}
                    controls
                    muted
                    loop
                    playsinline
                    preload="none"
                  >
                    <source
                      src={`${figure.src}.av1.mp4`}
                      type='video/mp4; codecs="av01.0.05M.08"'
                    />
                    <source src={`${figure.src}.h264.mp4`} type="video/mp4" />
                  </video>
                ),
              )}
            </section>
          ))
        }

        <nav class="next" aria-label={t.caseStudy.next}>
          <SectionLabel>{t.caseStudy.next}</SectionLabel>
          <a href={pathFor(content.next.route, lang)}>
            {content.next.name}
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1"
              ></path>
            </svg>
          </a>
        </nav>
      </div>
    </div>
  </article>
  <SmoothScroll />
</Base>

<script>
  // Walkthrough videos play silently while visible, unless motion is reduced.
  // The native controls stay, so they can always be paused.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) void video.play().catch(() => {});
        else video.pause();
      }
    });
    document.querySelectorAll('video.video').forEach((video) => observer.observe(video));
  }
</script>

<style>
  .case {
    padding-inline: var(--margin);
  }

  .hero,
  .body {
    max-width: var(--container);
    margin-inline: auto;
  }

  .hero {
    display: grid;
    gap: var(--space-7);
    padding-top: calc(var(--space-9) + var(--space-4));
  }

  .intro {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    color: var(--fg-muted);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
  }

  .back:hover {
    color: var(--fg);
  }

  h1 {
    font-size: var(--text-hero);
    line-height: var(--leading-display);
  }

  .lead {
    max-width: 40rem;
    font-size: var(--text-lead);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    width: 100%;
    padding-top: var(--space-5);
    border-top: var(--hairline);
  }

  dt {
    color: var(--fg-muted);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
  }

  dd {
    margin: 0;
  }

  .hero :global(.cover) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: var(--section);
  }

  .chapters {
    display: grid;
    gap: var(--section);
    min-width: 0;
    padding-top: var(--space-8);
  }

  .chapter {
    display: grid;
    gap: var(--space-7);
    scroll-margin-top: var(--space-10);
  }

  .text {
    display: grid;
    gap: var(--space-5);
    max-width: var(--measure);
  }

  h2 {
    font-size: var(--text-heading);
  }

  .text p {
    color: var(--fg-muted);
  }

  .text p:first-of-type {
    color: var(--fg);
    font-size: var(--text-lead);
  }

  .list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .list li {
    padding-left: var(--space-5);
    border-left: 2px solid var(--accent);
  }

  .roles {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: var(--hairline);
  }

  .video {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background-color: var(--ink);
  }

  .video.narrow {
    max-width: 20rem;
  }

  .next {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-7);
    border-top: var(--hairline);
  }

  .next a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.15em;
    width: fit-content;
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-decoration: none;
  }

  .next a:hover {
    color: var(--accent);
  }

  .next svg {
    width: 0.5em;
    height: 0.5em;
  }

  @media (width >= 48rem) {
    .facts {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }

  @media (width >= 64rem) {
    .hero {
      padding-top: var(--space-10);
    }

    .body {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-8);
    }

    .body :global(.chapter-nav) {
      align-self: start;
      padding-top: var(--space-8);
    }
  }
</style>
