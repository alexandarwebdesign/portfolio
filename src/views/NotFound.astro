---
import Button from '../components/Button.astro';
import { pathFor } from '../i18n/routes';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = {
  bg: {
    title: ['Тази страница', 'се изгуби.'],
    text: 'Адресът може да е сгрешен или страницата да е преместена. Ето откъде да продължите.',
    home: 'Към началото',
    work: 'Вижте проектите',
  },
  en: {
    title: ['This page has', 'drifted away.'],
    text: 'The address may be mistyped, or the page has moved. Here is where to go next.',
    home: 'Back to home',
    work: 'See the work',
  },
}[lang];
const home = pathFor('home', lang)!;
---

<section class="section first not-found">
  <div class="container inner">
    <p class="code" aria-hidden="true">404</p>
    <h1 class="title-display title-split">
      <span>{t.title[0]}</span>
      <span>{t.title[1]}</span>
    </h1>
    <p class="text">{t.text}</p>
    <div class="actions">
      <Button href={home} arrow>{t.home}</Button>
      <Button href={home === '/' ? '/#work' : `${home}#work`} variant="secondary">{t.work}</Button>
    </div>
  </div>
</section>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: 80svh;
  }

  .inner {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .code {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--text-heading);
    line-height: 1;
  }

  .text {
    max-width: 32rem;
    color: var(--fg-muted);
    font-size: var(--text-lead);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
