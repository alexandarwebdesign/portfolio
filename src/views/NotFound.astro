---
// The 404 page, in pure CSS: a wireframe tunnel that flies toward you and a thick "404" that sways
// in it, then one line and one button home. No scripts, no WebGL, no libraries: everything moves
// with `transform` only, so it runs on the compositor and costs the main thread nothing.
// Standalone: no header or footer.
import Seo from '../components/Seo.astro';
import Button from '../components/Button.astro';
import '../styles/tokens.css';
import '../styles/button.css';
import manropeLatin from '../assets/fonts/manrope-latin.woff2?url';
import manropeCyrillic from '../assets/fonts/manrope-cyrillic.woff2?url';
import { ui, type Lang } from '../i18n/ui';
import { pathFor } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = ui[lang].meta.notFound;
const t = {
  bg: {
    message: 'Тази страница се изгуби в празнотата.',
    button: 'Обратно към сигнала',
  },
  en: {
    message: 'This page has drifted into the void.',
    button: 'Return to Signal',
  },
}[lang];
// the "404" is a stack of copies one behind the other: seen from the side it is a solid block
const LAYERS = Array.from({ length: 16 }, (_, i) => i);
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={meta.title} description={meta.description} {lang} route="notFound" noindex />
    <link
      rel="preload"
      href={lang === 'bg' ? manropeCyrillic : manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#efefef" />
  </head>
  <body>
    <div class="scene" aria-hidden="true">
      <div class="tunnel">
        <div class="plane plane--floor"><div class="grid"></div></div>
        <div class="plane plane--ceiling"><div class="grid"></div></div>
        <div class="plane plane--left"><div class="grid"></div></div>
        <div class="plane plane--right"><div class="grid"></div></div>
      </div>
      <div class="fog"></div>
      <div class="number">
        <div class="layers">
          {LAYERS.map((i) => <span style={`--i: ${i}`}>404</span>)}
        </div>
      </div>
    </div>
    <main class="content">
      <h1 class="sr-only">404</h1>
      <p class="message">{t.message}</p>
      <Button href={pathFor('home', lang)}>{t.button}</Button>
    </main>

    <style is:global>
      @font-face {
        font-family: 'Manrope';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('../assets/fonts/manrope-latin.woff2') format('woff2');
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
          U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Manrope';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('../assets/fonts/manrope-cyrillic.woff2') format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+2116;
      }

      :root {
        /* the tunnel: half the width of its cross-section, its length, and one square of the grid */
        --r: clamp(200px, 34vmin, 420px);
        --depth: 2400px;
        --cell: 80px;
        --line: color-mix(in srgb, var(--color-ink) 22%, transparent);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Manrope', sans-serif;
        background: var(--color-background);
        color: var(--color-ink);
        overflow: hidden;
      }

      .content {
        position: relative;
        z-index: 1;
        min-height: 100svh;
        padding: 0 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
      }

      .scene {
        position: fixed;
        inset: 0;
        perspective: 900px;
        overflow: hidden;
        pointer-events: none;
      }

      /* fog: the far end of the tunnel dissolves into the page colour */
      .fog {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 50%, var(--color-background) 0, transparent 38%);
      }

      /* The tunnel starts in front of the screen so its walls fill it, and turns slowly on its axis. */
      .tunnel {
        position: absolute;
        inset: 0;
        transform-style: preserve-3d;
        transform: translateZ(600px);
        animation: spin 90s linear infinite;
      }

      .plane {
        position: absolute;
        left: 50%;
        top: 50%;
        overflow: hidden;
      }

      /* each wall lies along the depth, starting at the screen and going away from it */
      .plane--floor {
        width: calc(var(--r) * 2);
        height: var(--depth);
        margin: var(--r) 0 0 calc(var(--r) * -1);
        transform-origin: 50% 0;
        transform: rotateX(-90deg);
      }

      .plane--ceiling {
        width: calc(var(--r) * 2);
        height: var(--depth);
        margin: calc(var(--r) * -1 - var(--depth)) 0 0 calc(var(--r) * -1);
        transform-origin: 50% 100%;
        transform: rotateX(90deg);
      }

      .plane--left {
        width: var(--depth);
        height: calc(var(--r) * 2);
        margin: calc(var(--r) * -1) 0 0 calc(var(--r) * -1);
        transform-origin: 0 50%;
        transform: rotateY(90deg);
      }

      .plane--right {
        width: var(--depth);
        height: calc(var(--r) * 2);
        margin: calc(var(--r) * -1) 0 0 calc(var(--r) - var(--depth));
        transform-origin: 100% 50%;
        transform: rotateY(-90deg);
      }

      /* One square larger than the wall, and moved by exactly one square: the loop has no seam, and only
         `transform` changes. */
      .grid {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(var(--line) 1px, transparent 1px) 0 0 / var(--cell) var(--cell),
          linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / var(--cell) var(--cell);
        will-change: transform;
        animation: 1.1s linear infinite;
      }

      .plane--floor .grid {
        bottom: calc(var(--cell) * -1);
        animation-name: toward-up;
      }

      .plane--ceiling .grid {
        top: calc(var(--cell) * -1);
        animation-name: toward-down;
      }

      .plane--left .grid {
        right: calc(var(--cell) * -1);
        animation-name: toward-left;
      }

      .plane--right .grid {
        left: calc(var(--cell) * -1);
        animation-name: toward-right;
      }

      @keyframes spin {
        to {
          transform: translateZ(600px) rotateZ(360deg);
        }
      }

      @keyframes toward-up {
        to {
          transform: translateY(calc(var(--cell) * -1));
        }
      }

      @keyframes toward-down {
        to {
          transform: translateY(var(--cell));
        }
      }

      @keyframes toward-left {
        to {
          transform: translateX(calc(var(--cell) * -1));
        }
      }

      @keyframes toward-right {
        to {
          transform: translateX(var(--cell));
        }
      }

      /* The number: sixteen copies one behind the other, so it is a block with a depth. It sways. */
      .number {
        position: absolute;
        left: 50%;
        top: 38%;
        translate: -50% -50%;
        transform-style: preserve-3d;
        animation: sway 7s ease-in-out infinite alternate;
      }

      .layers {
        display: grid;
        transform-style: preserve-3d;
      }

      .layers span {
        grid-area: 1 / 1;
        font-size: clamp(120px, 30vw, 320px);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
        /* the front copy is the ink; the copies behind it fade toward the page */
        color: color-mix(
          in srgb,
          var(--color-ink) calc(100% - var(--i) * 4%),
          var(--color-background)
        );
        transform: translateZ(calc(32px - var(--i) * 4px));
      }

      @keyframes sway {
        from {
          transform: rotateX(8deg) rotateY(-24deg);
        }
        to {
          transform: rotateX(-6deg) rotateY(24deg);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .tunnel,
        .grid,
        .number {
          animation: none;
        }

        .number {
          transform: rotateX(4deg) rotateY(-14deg);
        }
      }

      .message {
        margin: clamp(160px, 36vh, 360px) 0 2rem;
        /* clears the lines of the grid behind the text */
        text-shadow:
          0 0 12px var(--color-background),
          0 0 24px var(--color-background);
        font-size: 1.5rem;
        opacity: 0.8;
        text-align: center;
      }

      @media (max-width: 768px) {
        .message {
          font-size: 1.125rem;
        }
      }
    </style>
  </body>
</html>
