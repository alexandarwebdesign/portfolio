---
// The 404 page: the number, one line of text and one button home. Static, no scripts.
// Standalone: no header or footer.
import Seo from '../components/Seo.astro';
import manropeLatin from '../assets/fonts/manrope-latin.woff2?url';
import manropeCyrillic from '../assets/fonts/manrope-cyrillic.woff2?url';
import { ui, type Lang } from '../i18n/ui';
import { pathFor } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = ui[lang].meta.notFound;
const t = {
  bg: {
    message: 'Тази страница се изгуби в празнотата.',
    button: 'Обратно към сигнала',
    label: 'Към началото',
  },
  en: {
    message: 'This page has drifted into the void.',
    button: 'Return to Signal',
    label: 'Return to Home',
  },
}[lang];
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={meta.title} description={meta.description} {lang} route="notFound" noindex />
    <link
      rel="preload"
      href={lang === 'bg' ? manropeCyrillic : manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#efefef" />
  </head>
  <body>
    <main class="content">
      <h1 class="code">404</h1>
      <p class="message">{t.message}</p>
      <a href={pathFor('home', lang)} class="home-btn" aria-label={t.label}>{t.button}</a>
    </main>

    <style is:global>
      @font-face {
        font-family: 'Manrope';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('../assets/fonts/manrope-latin.woff2') format('woff2');
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
          U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Manrope';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('../assets/fonts/manrope-cyrillic.woff2') format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+2116;
      }

      :root {
        --color-background: #efefef;
        --color-ink: #1c1c1c;
        --color-accent: #0066cc;
        --color-on-dark: #ededed;
        --ease: cubic-bezier(0.55, 0, 0.1, 1);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Manrope', sans-serif;
        background: var(--color-background);
        color: var(--color-ink);
        overflow-x: hidden;
      }

      .content {
        min-height: 100svh;
        padding: 0 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .code {
        font-size: clamp(96px, 22vw, 240px);
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .message {
        margin: 1rem 0 2rem;
        font-size: 1.5rem;
        opacity: 0.8;
        text-align: center;
      }

      .home-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 18px 36px;
        border: 1px solid transparent;
        border-radius: 4px;
        background: var(--color-ink);
        color: var(--color-on-dark);
        font-weight: 600;
        font-size: 18px;
        line-height: 1.5;
        text-decoration: none;
        transition:
          background 450ms var(--ease),
          transform 450ms var(--ease);
      }

      .home-btn:hover {
        background: var(--color-accent);
        transform: translateY(-2px);
      }

      .home-btn:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
      }

      @media (max-width: 768px) {
        .message {
          font-size: 1.125rem;
        }

        .home-btn {
          min-width: 180px;
          padding: 14px 28px;
          font-size: 16px;
        }
      }
    </style>
  </body>
</html>
