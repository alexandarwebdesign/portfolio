---
import Button from '../components/Button.astro';
import { pathFor } from '../i18n/routes';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = {
  bg: {
    title: ['Тази страница', 'се изгуби.'],
    text: 'Адресът може да е сгрешен или страницата да е преместена. Ето откъде да продължите.',
    home: 'Към началото',
    work: 'Вижте проектите',
  },
  en: {
    title: ['This page has', 'drifted away.'],
    text: 'The address may be mistyped, or the page has moved. Here is where to go next.',
    home: 'Back to home',
    work: 'See the work',
  },
}[lang];
const home = pathFor('home', lang)!;
---

<section class="not-found">
  <p class="code" aria-hidden="true">404</p>
  <h1>
    <span>{t.title[0]}</span>
    <span class="offset">{t.title[1]}</span>
  </h1>
  <p class="text">{t.text}</p>
  <div class="actions">
    <Button href={home} arrow>{t.home}</Button>
    <Button href={home === '/' ? '/#work' : `${home}#work`} variant="secondary">{t.work}</Button>
  </div>
</section>

<style>
  .not-found {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-5);
    min-height: 80svh;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: calc(var(--space-9) + var(--space-4)) var(--gutter) var(--section);
  }

  .code {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--text-heading);
    line-height: 1;
  }

  h1 {
    display: grid;
    font-size: var(--text-display);
    line-height: var(--leading-display);
  }

  .offset {
    padding-inline-start: 0.6em;
  }

  .text {
    max-width: 32rem;
    color: var(--fg-muted);
    font-size: var(--text-lead);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
