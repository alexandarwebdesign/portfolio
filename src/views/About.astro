---
import { Picture } from 'astro:assets';
import Button from '../components/Button.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import portrait from '../assets/images/portrait.jpg';
import { about } from '../data/about';
import { work } from '../data/home';
import { pathFor } from '../i18n/routes';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = about[lang];
const home = pathFor('home', lang)!;
const homeHash = (hash: string) => (home === '/' ? `/${hash}` : `${home}${hash}`);
---

<section class="section first">
  <div class="container intro">
    <div class="text">
      <SectionLabel>{t.label}</SectionLabel>
      <h1 class="title-display title-split">
        <span>{t.title[0]}</span>
        <span>{t.title[1]}</span>
      </h1>
      <p class="lead">{t.lead}</p>
      {t.text.map((paragraph) => <p>{paragraph}</p>)}
      <div class="actions">
        <Button href={homeHash('#contact')} arrow>{t.start}</Button>
        <Button href={homeHash('#process')} variant="secondary">{t.process}</Button>
      </div>
    </div>
    <aside class="side">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        widths={[400, 640, 960]}
        sizes="(width >= 64rem) 30vw, 100vw"
        alt={t.alt}
        loading="eager"
        class="portrait"
      />
      <dl class="facts">
        {
          t.facts.map((fact) => (
            <div>
              <dt>{fact.term}</dt>
              <dd>{fact.desc}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>

<section class="section dark" aria-labelledby="about-work">
  <div class="container">
    <header class="section-head">
      <h2 id="about-work">{t.work}</h2>
    </header>
    <ul class="card-grid">
      {
        work
          .filter((item) => item.route)
          .map((item) => (
            <ProjectCard
              name={item.name}
              category={item.category[lang]}
              image={item.image}
              href={pathFor(item.route!, lang)}
              tag={item.tag?.[lang]}
            />
          ))
      }
    </ul>
  </div>
</section>

<SmoothScroll />

<style>
  .intro {
    display: grid;
    gap: var(--section-head) var(--column-gap);
  }

  .text {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .text h1 {
    margin-bottom: var(--space-3);
  }

  .text > p {
    max-width: var(--measure);
  }

  .text > p:not(.lead) {
    color: var(--fg-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-3);
  }

  .side {
    display: grid;
    align-content: start;
    gap: var(--stack);
  }

  .side :global(.portrait) {
    width: 100%;
    max-width: 26rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
  }

  .facts div {
    padding-top: var(--space-3);
    border-top: var(--hairline);
  }

  dt {
    color: var(--fg-muted);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
  }

  dd {
    margin: 0;
  }

  /* Text on columns 1–7, portrait and facts on 9–12, kept in view. */
  @media (width >= 64rem) {
    .intro {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }

    .text {
      grid-column: 1 / span 7;
    }

    .side {
      position: sticky;
      top: var(--top-clear);
      grid-column: 9 / -1;
      align-self: start;
    }

    .side :global(.portrait) {
      max-width: none;
    }
  }
</style>
