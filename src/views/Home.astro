---
import { Picture } from 'astro:assets';
import Hero from '../components/Hero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Marquee from '../components/Marquee.astro';
import ConceptStrip from '../components/ConceptStrip.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import BriefBuilder from '../components/BriefBuilder.astro';
import Button from '../components/Button.astro';
import AboutIndex from '../components/AboutIndex.astro';
import ServiceShowcase from '../components/ServiceShowcase.astro';
import Showreel from '../components/Showreel.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import portrait from '../assets/images/portrait.jpg';
import servicePdp from '../assets/images/birse-pdp.jpg';
import serviceBuild from '../assets/images/forma-home.jpg';
import serviceWhole from '../assets/images/birse-hero.jpg';
import { home, work } from '../data/home';
import { about } from '../data/about';
import { services } from '../data/services';
import { process } from '../data/process';
import { faq } from '../data/faq';
import { site } from '../data/site';
import { pathFor } from '../i18n/routes';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const serviceImages = [servicePdp, serviceBuild, serviceWhole];
const serviceItems = services[lang].map((service, i) => ({ ...service, image: serviceImages[i] }));
---

<Hero {...t.hero} />

<Showreel {...t.reel} href={pathFor('forma', lang)!} />

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.work.label}</SectionLabel>
      <h2 id="work-title">{t.work.title}</h2>
    </header>
    <ul class="card-grid">
      {
        work.map((item) => (
          <ProjectCard
            name={item.name}
            category={item.category[lang]}
            image={item.image}
            href={item.route && pathFor(item.route, lang)}
            status={item.status?.[lang]}
            tag={item.tag?.[lang]}
          />
        ))
      }
    </ul>
  </div>
</section>

<ConceptStrip {lang} raised />

<Marquee label={t.industries.label} items={t.industries.items} />

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.services.label}</SectionLabel>
      <h2 id="services-title" class="title-split">
        <span>{t.services.title[0]}</span>
        <span>{t.services.title[1]}</span>
      </h2>
    </header>
    <ServiceShowcase items={serviceItems} />
    <div class="services-cta">
      <Button href="#contact" size="large">{t.services.cta}</Button>
    </div>
  </div>
</section>

<section id="process" class="section raised" aria-labelledby="process-title">
  <div class="container split">
    <header class="section-head sticky" data-reveal>
      <SectionLabel>{t.process.label}</SectionLabel>
      <h2 id="process-title">{t.process.title}</h2>
    </header>
    <div data-reveal><Process steps={process[lang]} /></div>
  </div>
</section>

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.about.label}</SectionLabel>
      <h2 id="about-title">{t.about.title}</h2>
    </header>
    <div class="about">
      <div class="portrait">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(width >= 64rem) 40vw, 92vw"
          alt={t.about.alt}
          loading="lazy"
        />
      </div>
      <div class="about-text" data-reveal>
        <p class="bio">{t.about.text}</p>
        <Button href={pathFor('about', lang)} variant="secondary" arrow>{t.about.link}</Button>
        <AboutIndex facts={about[lang].facts} />
      </div>
    </div>
  </div>
</section>

<section id="faq" class="section raised" aria-labelledby="faq-title">
  <div class="container split">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.faq.label}</SectionLabel>
      <h2 id="faq-title">{t.faq.title}</h2>
    </header>
    <Faq items={faq[lang]} />
  </div>
</section>

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container split">
    <header class="section-head">
      <SectionLabel>{t.contact.label}</SectionLabel>
      <h2 id="contact-title" class="title-split">
        <span>{t.contact.title[0]}</span>
        <span>{t.contact.title[1]}</span>
      </h2>
      <p class="lead">{t.contact.lead}</p>
      <p class="muted">{t.contact.reply}</p>
      <p class="muted">
        {t.contact.email}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </header>
    <BriefBuilder {lang} />
  </div>
</section>

<SmoothScroll />

<style>
  .services-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--section-head);
  }

  /* About: a large portrait leads, the words and the facts beside it. */
  .about {
    display: grid;
    gap: var(--section-head) var(--column-gap);
  }

  .portrait {
    overflow: hidden;
    border-radius: var(--radius);
    background-color: var(--bg-sunken);
  }

  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
  }

  .about-text {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--space-6);
  }

  .about-text :global(.about-index) {
    width: 100%;
  }

  @media (width >= 64rem) {
    .about {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }

    .portrait {
      grid-column: 1 / span 5;
    }

    .about-text {
      grid-column: 7 / -1;
    }
  }

  .bio {
    max-width: 40ch;
    color: var(--fg-muted);
    font-size: clamp(1.25rem, 1.4vw, 1.5rem); /* 20 → 24 */
    line-height: 1.6;
  }
</style>
