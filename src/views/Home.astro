---
// The original home page: hero over the shader, 2 × 2 work, the image
// marquee, about, services, FAQ and the contact form.
import { Picture } from 'astro:assets';
import HeroShader from '../components/HeroShader.astro';
import Button from '../components/Button.astro';
import WorkCard from '../components/WorkCard.astro';
import ImageMarquee from '../components/ImageMarquee.astro';
import AboutIndex from '../components/AboutIndex.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import StatusIcon from '../components/StatusIcon.astro';
import portrait from '../assets/images/portrait.jpg';
import { home, work } from '../data/home';
import { about } from '../data/about';
import { services } from '../data/services';
import { faq } from '../data/faq';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';
import { pathFor } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const s = ui[lang].site;
const shapes = ['circle', 'triangle', 'hexagon'] as const;
const serviceIds = ['web-design', 'website-dev', 'end-to-end'];
const count = String(work.length).padStart(2, '0');
// Two columns, the second one dropped: 1st and 3rd on the left, 2nd and 4th on the right.
const indexed = work.map((item, index) => ({ item, index }));
const columns = [
  indexed.filter(({ index }) => index % 2 === 0),
  indexed.filter(({ index }) => index % 2 === 1),
];
---

<section id="hero" class="hero-section hero-section--shader">
  <HeroShader />
  <div class="hero-content">
    <p class="hero-eyebrow">{t.hero.eyebrow}</p>
    <h1 class="hero-title">{t.hero.title}</h1>
    <p class="hero-subtitle">{t.hero.lead}</p>
    <Button href="#contact" class="hero-cta" data-focus-target="#name">{t.hero.cta}</Button>
  </div>
</section>

<section class="statement-section">
  <div class="container">
    <p class="statement reveal">
      {t.statement.before}<mark class="statement-mark">{t.statement.mark}</mark>{t.statement.after}
    </p>
  </div>
</section>

<section id="work" class="work-section">
  <div class="container">
    <header class="section-header reveal">
      <p class="mono-label">
        <span class="index">(01)</span>
        {t.work.label} &middot; {count}
        {t.work.count}
      </p>
      <h2 class="section-title">{t.work.title}</h2>
    </header>
    <div class="work-stagger">
      {
        columns.map((column, c) => (
          <div class:list={['work-col', { 'work-col--b': c === 1 }]}>
            {column.map(({ item, index }) => (
              <WorkCard
                name={item.name}
                index={index}
                category={item.category[lang]}
                image={item.image}
                href={item.route && pathFor(item.route, lang)}
                status={item.status?.[lang]}
                tag={item.tag?.[lang]}
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<ImageMarquee {lang} />

<section id="about" class="about-section">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(02)</span> {t.about.label}</p>
      <h2 class="section-title">{t.about.title}</h2>
    </div>
    <div class="about-grid reveal">
      <div class="about-lead">
        <div class="about-heading-content">
          <div class="about-photo-circle">
            <Picture
              src={portrait}
              formats={['avif', 'webp']}
              widths={[96, 192, 288]}
              sizes="96px"
              alt={t.about.alt}
              loading="lazy"
            />
          </div>
        </div>
        <p class="about-bio-new">{t.about.text}</p>
        <Button href={pathFor('about', lang)} variant="secondary">{t.about.link}</Button>
      </div>
      <AboutIndex facts={about[lang].facts} />
    </div>
  </div>
</section>

<section id="services" class="services-section">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(03)</span> {t.services.label}</p>
      <h2 class="section-title">{t.services.title.join(' ')}</h2>
    </div>
    <div class="services-list">
      {
        services[lang].map((service, i) => (
          <div class="service-row reveal" data-service={serviceIds[i]}>
            <span class="service-index" aria-hidden="true">
              ({String(i + 1).padStart(2, '0')})
            </span>
            <h3 class="service-title">{service.title}</h3>
            <div class="service-body">
              <p class="service-desc">{service.text}</p>
              <a
                href="#contact"
                class="service-pick"
                data-service-pick={serviceIds[i]}
                data-focus-target="#name"
              >
                {t.services.pick} <span aria-hidden="true">→</span>
                <span class="sr-only">: {service.title}</span>
              </a>
            </div>
            <ServiceIcon shape={shapes[i % shapes.length]} />
          </div>
        ))
      }
    </div>
    <div class="services-cta reveal">
      <Button href="#contact">{t.services.cta}</Button>
    </div>
  </div>
</section>

<section id="faq" class="faq-section" aria-labelledby="faq-title">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(04)</span> {t.faq.label}</p>
      <h2 id="faq-title" class="section-title">{t.faq.title}</h2>
    </div>
    <Faq items={faq[lang]} />
  </div>
</section>

<section id="contact" class="contact-section">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(05)</span> {t.contact.label}</p>
    </div>
    <div class="contact-grid">
      <div class="contact-info reveal">
        <div class="availability-signal">
          <StatusIcon class="availability-icon" />
          <span>{s.available}</span>
        </div>
        <h2 class="contact-title">
          <span>{t.contact.title[0]}</span>
          <span>{t.contact.title[1]}</span>
        </h2>
        <p class="contact-subtitle">{t.contact.lead}</p>
        <div class="contact-email">
          <p class="email-label">{t.contact.email}</p>
          <a href={`mailto:${site.email}`} class="email-link" aria-label={s.emailTo}>{site.email}</a
          >
        </div>
      </div>
      <ContactForm {lang} />
    </div>
  </div>
</section>
