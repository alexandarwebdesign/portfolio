---
import { Picture } from 'astro:assets';
import Hero from '../components/Hero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Marquee from '../components/Marquee.astro';
import ConceptStrip from '../components/ConceptStrip.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import BriefBuilder from '../components/BriefBuilder.astro';
import Button from '../components/Button.astro';
import AboutIndex from '../components/AboutIndex.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import portrait from '../assets/images/portrait.jpg';
import { home, work } from '../data/home';
import { about } from '../data/about';
import { services } from '../data/services';
import { process } from '../data/process';
import { faq } from '../data/faq';
import { site } from '../data/site';
import { pathFor } from '../i18n/routes';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const shapes = ['circle', 'triangle', 'hexagon'] as const;
---

<Hero {...t.hero} />

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.work.label}</SectionLabel>
      <h2 id="work-title">{t.work.title}</h2>
    </header>
    <ul class="card-grid">
      {
        work.map((item) => (
          <ProjectCard
            name={item.name}
            category={item.category[lang]}
            image={item.image}
            href={item.route && pathFor(item.route, lang)}
            status={item.status?.[lang]}
            tag={item.tag?.[lang]}
          />
        ))
      }
    </ul>
  </div>
</section>

<ConceptStrip {lang} raised />

<Marquee label={t.industries.label} items={t.industries.items} />

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.services.label}</SectionLabel>
      <h2 id="services-title" class="title-split">
        <span>{t.services.title[0]}</span>
        <span>{t.services.title[1]}</span>
      </h2>
    </header>
    <ol class="index-rows with-icon">
      {
        services[lang].map((service, i) => (
          <li data-reveal>
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <ServiceIcon shape={shapes[i % shapes.length]} />
          </li>
        ))
      }
    </ol>
    <div class="services-cta">
      <Button href="#contact" size="large">{t.services.cta}</Button>
    </div>
  </div>
</section>

<section id="process" class="section raised" aria-labelledby="process-title">
  <div class="container split">
    <header class="section-head sticky" data-reveal>
      <SectionLabel>{t.process.label}</SectionLabel>
      <h2 id="process-title">{t.process.title}</h2>
    </header>
    <div data-reveal><Process steps={process[lang]} /></div>
  </div>
</section>

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.about.label}</SectionLabel>
      <h2 id="about-title">{t.about.title}</h2>
    </header>
    <div class="split about" data-reveal>
      <div class="about-lead">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[96, 192]}
          sizes="96px"
          alt={t.about.alt}
          loading="lazy"
          class="avatar"
        />
        <p class="bio">{t.about.text}</p>
        <Button href={pathFor('about', lang)} variant="secondary" arrow>{t.about.link}</Button>
      </div>
      <AboutIndex facts={about[lang].facts} />
    </div>
  </div>
</section>

<section id="faq" class="section raised" aria-labelledby="faq-title">
  <div class="container split">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.faq.label}</SectionLabel>
      <h2 id="faq-title">{t.faq.title}</h2>
    </header>
    <Faq items={faq[lang]} />
  </div>
</section>

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container split">
    <header class="section-head">
      <SectionLabel>{t.contact.label}</SectionLabel>
      <h2 id="contact-title" class="title-split">
        <span>{t.contact.title[0]}</span>
        <span>{t.contact.title[1]}</span>
      </h2>
      <p class="lead">{t.contact.lead}</p>
      <p class="muted">{t.contact.reply}</p>
      <p class="muted">
        {t.contact.email}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </header>
    <BriefBuilder {lang} />
  </div>
</section>

<SmoothScroll />

<style>
  .services-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--section-head);
  }

  /* The original about block: small round portrait, bio and link, index beside. */
  .about {
    align-items: center;
  }

  .about-lead {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  .about-lead :global(.avatar) {
    width: 6rem; /* 96 */
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
  }

  .bio {
    max-width: 40ch;
    color: var(--fg-muted);
    font-size: clamp(1.25rem, 1.4vw, 1.5rem); /* 20 → 24 */
    line-height: 1.6;
  }
</style>
