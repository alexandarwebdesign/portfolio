---
// The offer page for local businesses, in both languages (/uslugi, /en/services).
import { Picture } from 'astro:assets';
import TickRing from '../components/TickRing.astro';
import Button from '../components/Button.astro';
import WorkCard from '../components/WorkCard.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactForm from '../components/ContactForm.astro';
import birseCard from '../assets/images/birse-card.jpg';
import heroImage from '../assets/images/hero/hero.jpg';
import { uslugiCopy } from '../data/uslugi';
import { ui, type Lang } from '../i18n/ui';
import { pathFor } from '../i18n/routes';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = uslugiCopy[lang];
const birsePath = pathFor('birse', lang)!;

const n = (i: number) => `(${String(i + 1).padStart(2, '0')})`;
---

<section id="hero" class="hero-section hero-stage stage">
  <TickRing corner="bl" />
  <TickRing corner="tr" />
  <div class="hero-content container">
    <div class="hero-heading">
      <p class="hero-eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero-title">{t.hero.title.join(' ')}</h1>
    </div>
    <div class="hero-picture" aria-hidden="true">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280]}
        sizes="(max-width: 900px) 62vw, 40vw"
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-aside">
      <p class="hero-subtitle">{t.hero.lead}</p>
      <Button href="#contact" class="hero-cta" data-focus-target="#name">{t.hero.cta}</Button>
      <p class="hero-note hero-proof">
        <a href="#ceni">{t.prices.items[0].title.split(' (')[0]} {t.prices.items[0].price}</a><br />
        {t.hero.reply}
      </p>
    </div>
  </div>
</section>

<section id="poznato" class="services-section" aria-labelledby="poznato-title">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(01)</span> {t.problem.label}</p>
      <h2 id="poznato-title" class="section-title">{t.problem.title}</h2>
    </div>
    <div class="services-list">
      {
        t.problem.items.map((item, i) => (
          <div class="service-row service-row--static reveal">
            <span class="service-index" aria-hidden="true">
              {n(i)}
            </span>
            <h3 class="service-title">{item}</h3>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section id="poluchavate" class="services-section" aria-labelledby="poluchavate-title">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(02)</span> {t.includes.label}</p>
      <h2 id="poluchavate-title" class="section-title">{t.includes.title}</h2>
    </div>
    <div class="services-list">
      {
        t.includes.items.map((item, i) => (
          <div class="service-row reveal">
            <span class="service-index" aria-hidden="true">
              {n(i)}
            </span>
            <h3 class="service-title">{item.title}</h3>
            <p class="service-desc">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section id="kak" class="services-section" aria-labelledby="kak-title">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(03)</span> {t.process.label}</p>
      <h2 id="kak-title" class="section-title">{t.process.title}</h2>
    </div>
    <div class="services-list">
      {
        t.process.steps.map((step, i) => (
          <div class="service-row reveal">
            <span class="service-index" aria-hidden="true">
              {n(i)}
            </span>
            <h3 class="service-title">{step.title}</h3>
            <p class="service-desc">{step.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section id="birse" class="work-section" aria-labelledby="birse-title">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(04)</span> {t.proof.label}</p>
      <h2 id="birse-title" class="section-title">{t.proof.title}</h2>
    </div>
    <div class="offer-proof">
      <WorkCard name="Birsé" category={t.proof.category} image={birseCard} href={birsePath} />
      <div class="offer-proof__text reveal">
        <p class="about-page-para">{t.proof.text}</p>
        <Button href={birsePath} variant="secondary">{t.proof.link}</Button>
      </div>
    </div>
  </div>
</section>

<section id="ceni" class="services-section" aria-labelledby="ceni-title">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(05)</span> {t.prices.label}</p>
      <h2 id="ceni-title" class="section-title">{t.prices.title}</h2>
    </div>
    <div class="services-list">
      {
        t.prices.items.map((item, i) => (
          <div class="service-row service-row--price reveal">
            <span class="service-index" aria-hidden="true">
              {n(i)}
            </span>
            <h3 class="service-title">{item.title}</h3>
            <p class="service-desc">{item.text}</p>
            <p class="service-price">{item.price}</p>
          </div>
        ))
      }
    </div>
    <p class="section-note reveal">{t.prices.note}</p>
    <div class="services-cta reveal">
      <Button href="#contact" data-focus-target="#name">{t.hero.cta}</Button>
    </div>
  </div>
</section>

<FaqSection
  {lang}
  index="(06)"
  label={t.faq.label}
  title={t.faq.title}
  items={t.faq.items}
  focus="#name"
/>

<section id="contact" class="contact-section stage">
  <div class="container">
    <div class="section-header reveal">
      <p class="mono-label"><span class="index">(07)</span> {t.contact.label}</p>
    </div>
    <div class="contact-grid">
      <div class="contact-info reveal">
        <h2 class="contact-title">
          <span>{t.contact.title[0]}</span>
          <span>{t.contact.title[1]}</span>
        </h2>
        <div class="contact-email">
          <p class="email-label">{t.contact.email}</p>
          <a href={`mailto:${site.email}`} class="email-link" aria-label={ui[lang].site.emailTo}
            >{site.email}</a
          >
        </div>
      </div>
      <ContactForm {lang} />
    </div>
  </div>
</section>
