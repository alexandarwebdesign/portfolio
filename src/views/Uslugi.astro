---
import { Picture } from 'astro:assets';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import BriefBuilder from '../components/BriefBuilder.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import birseCard from '../assets/images/birse-card.jpg';
import { uslugi as t } from '../data/uslugi';
import { site } from '../data/site';
import { pathFor } from '../i18n/routes';
---

<Hero
  eyebrow={t.hero.eyebrow}
  title={t.hero.title.join(' ')}
  lead={t.hero.lead}
  cta={t.hero.cta}
  note={t.hero.reply}
  compact
/>

<section class="section raised" aria-labelledby="problem-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.problem.label}</SectionLabel>
      <h2 id="problem-title">{t.problem.title}</h2>
    </header>
    <ol class="cards">
      {
        t.problem.items.map((item, i) => (
          <li data-reveal>
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            <p class="lead">{item}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="includes-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.includes.label}</SectionLabel>
      <h2 id="includes-title">{t.includes.title}</h2>
    </header>
    <ol class="index-rows">
      {
        t.includes.items.map((item, i) => (
          <li data-reveal>
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section raised" aria-labelledby="process-title">
  <div class="container split">
    <header class="section-head sticky" data-reveal>
      <SectionLabel>{t.process.label}</SectionLabel>
      <h2 id="process-title">{t.process.title}</h2>
    </header>
    <div data-reveal><Process steps={t.process.steps} /></div>
  </div>
</section>

<section class="section dark" aria-labelledby="prices-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <SectionLabel>{t.prices.label}</SectionLabel>
      <h2 id="prices-title">{t.prices.title}</h2>
    </header>
    <ul class="prices">
      {
        t.prices.items.map((item) => (
          <li data-reveal>
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
            <p class="price">{item.price}</p>
          </li>
        ))
      }
    </ul>
    <div class="prices-foot">
      <p class="note">{t.prices.note}</p>
      <Button href="#contact" arrow>{t.hero.cta}</Button>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="proof-title">
  <div class="container">
    <header class="section-head">
      <SectionLabel>{t.proof.label}</SectionLabel>
      <h2 id="proof-title">{t.proof.title}</h2>
    </header>
    <a class="proof-card" href={pathFor('birse', 'bg')}>
      <span class="proof-media">
        <Picture
          src={birseCard}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(width >= 64rem) 55vw, 100vw"
          alt=""
          loading="lazy"
        />
      </span>
      <span class="proof-text">
        <span class="name">Birsé <span class="muted">· {t.proof.category}</span></span>
        <span class="muted">{t.proof.text}</span>
        <span class="link">{t.proof.link} →</span>
      </span>
    </a>
  </div>
</section>

<section class="section raised" aria-labelledby="faq-title">
  <div class="container split">
    <header class="section-head">
      <SectionLabel>{t.faq.label}</SectionLabel>
      <h2 id="faq-title">{t.faq.title}</h2>
    </header>
    <Faq items={t.faq.items} />
  </div>
</section>

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container split">
    <header class="section-head">
      <SectionLabel>{t.contact.label}</SectionLabel>
      <h2 id="contact-title">{t.contact.title}</h2>
      <p class="lead">{t.contact.lead}</p>
      <p class="muted">
        {t.contact.email}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </header>
    <BriefBuilder lang="bg" choices={t.contact.choices} phone />
  </div>
</section>

<SmoothScroll />

<style>
  h3 {
    font-size: var(--text-title);
  }

  .index {
    color: var(--accent);
    font-size: var(--text-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Three statements side by side, each under a hairline. */
  .cards {
    display: grid;
    gap: var(--stack) var(--column-gap);
    padding: 0;
    list-style: none;
  }

  .cards li {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line-strong);
  }

  .prices {
    display: grid;
    gap: var(--column-gap);
    padding: 0;
    list-style: none;
  }

  .prices li {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--stack);
    border: var(--hairline);
    border-radius: var(--radius);
    background-color: var(--bg-raised);
  }

  .price {
    margin-top: auto;
    padding-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-heading);
    line-height: 1;
  }

  .prices-foot {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    margin-top: var(--section-head);
  }

  .note {
    max-width: var(--measure);
    color: var(--fg-muted);
    font-size: var(--text-small);
  }

  .proof-card {
    display: grid;
    gap: var(--stack) var(--column-gap);
    text-decoration: none;
  }

  .proof-media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .proof-card :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .proof-text {
    display: grid;
    align-content: center;
    gap: var(--space-4);
    max-width: 34rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    line-height: 1;
  }

  .name .muted {
    font-family: var(--font-body);
    font-size: var(--text-small);
  }

  .link {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .proof-card:hover .link {
    color: var(--accent);
  }

  @media (width >= 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .cards,
    .prices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Image on columns 1–7, text on 9–12. */
    .proof-card {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }

    .proof-media {
      grid-column: 1 / span 7;
    }

    .proof-text {
      grid-column: 9 / -1;
    }
  }
</style>
